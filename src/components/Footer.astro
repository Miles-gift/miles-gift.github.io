---
import { profileConfig, siteConfig } from "../config";
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <p>© {profileConfig.startYear}–{currentYear} {profileConfig.name} · {siteConfig.title}</p>
  <nav aria-label="页脚导航">
    <a href="/articles/">文章</a><a href="/resources/">资料库</a><a href="/journey/">旅程</a><a href="/archives/">归档</a><a href="/about/">关于</a>
  </nav>
</footer>

<style>
  .site-footer { display: grid; justify-items: center; gap: .75rem; margin-top: 4rem; padding: 2rem 1rem 5rem; border-top: 1px solid var(--color-border); background: var(--color-canvas); color: var(--color-ink-secondary); text-align: center; }
  p { margin: 0; font-size: .9rem; }
  nav { display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem; }
  a { padding: .2rem .55rem; border: 1px solid var(--color-border); border-radius: 999px; color: inherit; font-size: .85rem; text-decoration: none; }
  a:hover { color: var(--color-accent); background: var(--color-surface-solid); }
</style>
