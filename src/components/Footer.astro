---
import { profileConfig } from "../config";

const introPage = profileConfig.indexPage || import.meta.env.BASE_URL;
---

<footer class="site-footer">
  <div class="site-footer__inner stage-shell">
    <div>
      <p class="site-footer__signature">持续学习，也持续留下些什么。</p>
      <p>© {profileConfig.startYear}–{new Date().getFullYear()} <a href={introPage}>{profileConfig.name}</a></p>
    </div>
    <nav aria-label="页脚导航">
      <a href="/thoughts/">短想法</a>
      <a href="/archives/">归档</a>
      <a href="/rss.xml">RSS</a>
      <a href="/privacy/">隐私</a>
      <a href="https://github.com/Miles-gift/miles-gift.github.io" target="_blank" rel="noopener noreferrer">源码</a>
      <a href="https://github.com/Motues/Momo" target="_blank" rel="noopener noreferrer">Momo 基础</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section-space);
    border-top: 1px solid var(--color-border);
    color: var(--color-ink-tertiary);
  }

  .site-footer__inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    padding-block: var(--space-7);
  }

  p { margin: 0.18rem 0; }

  .site-footer__signature {
    color: var(--color-ink);
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover { color: var(--color-accent); }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-5);
    font-size: var(--text-small);
  }

  @media (max-width: 640px) {
    .site-footer__inner {
      align-items: flex-start;
      flex-direction: column;
    }

    nav { justify-content: flex-start; }
  }
</style>
