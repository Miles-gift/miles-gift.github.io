---
import MainPageLayout from "@layouts/MainPageLayout.astro";
import CinematicHero from "@components/ui/CinematicHero.astro";
import FloatingPanel from "@components/ui/FloatingPanel.astro";
import FabMenu from "@components/control/FabMenu.astro";

interface Props {
  title: string;
  pageTitle: string;
  description: string;
  eyebrow?: string;
  lang: string;
}

const { title, pageTitle, description, eyebrow, lang } = Astro.props;
---

<MainPageLayout title={pageTitle} description={description} lang={lang}>
  <CinematicHero title={title} description={description} />
  <FloatingPanel id="page-content" class="collection-shell">
    {eyebrow && <p class="collection-shell__context">{eyebrow}</p>}
    <slot />
  </FloatingPanel>
  <FabMenu showBackBottom={true} />
</MainPageLayout>

<style>
  :global(.collection-shell) { padding-bottom: var(--space-8); }
  .collection-shell__context { margin: 0 0 1.5rem; color: var(--color-accent); font-size: .84rem; }
</style>
