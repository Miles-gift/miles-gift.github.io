---
import Chip from "@components/ui/Chip.astro";
import { entryPath } from "@utils/content-utils";
import type { CollectionEntry } from "astro:content";

interface Props { resources: CollectionEntry<"resources">[]; }
const { resources } = Astro.props;

const typeLabels: Record<string, string> = { book: "书籍", course: "课程", paper: "论文", article: "文章", documentation: "文档", tool: "工具", video: "视频", podcast: "播客", repository: "代码仓库", dataset: "数据集", website: "网站" };
const statusLabels: Record<string, string> = { inbox: "待整理", learning: "学习中", completed: "已完成", reference: "常用参考", archived: "已归档" };
const types = [...new Set(resources.map((item) => item.data.resourceType))].sort();
const statuses = [...new Set(resources.map((item) => item.data.status))].sort();
const topics = [...new Set(resources.map((item) => item.data.topic))].sort();
---

<section class="resource-library" aria-labelledby="resource-filter-title">
  <form id="resource-filter" class="resource-filter" role="search">
    <div class="resource-filter__heading">
      <div><p>按学习状态整理</p><h2 id="resource-filter-title">找到现在需要的资料</h2></div>
      <p id="resource-count" aria-live="polite">{resources.length} 条资料</p>
    </div>
    <label><span>关键词</span><input id="resource-query" name="q" type="search" placeholder="标题、描述或标签" /></label>
    <label><span>主题</span><select id="resource-topic" name="topic"><option value="">全部主题</option>{topics.map((topic) => <option value={topic}>{topic}</option>)}</select></label>
    <label><span>类型</span><select id="resource-type" name="type"><option value="">全部类型</option>{types.map((type) => <option value={type}>{typeLabels[type] || type}</option>)}</select></label>
    <label><span>状态</span><select id="resource-status" name="status"><option value="">全部状态</option>{statuses.map((status) => <option value={status}>{statusLabels[status] || status}</option>)}</select></label>
    <button id="resource-reset" type="reset">重置</button>
  </form>

  <div id="resource-grid" class="resource-grid">
    {resources.map((resource) => (
      <article
        data-resource-card
        data-title={`${resource.data.title} ${resource.data.description} ${resource.data.tags.join(" ")}`.toLowerCase()}
        data-topic={resource.data.topic}
        data-type={resource.data.resourceType}
        data-status={resource.data.status}
      >
        <a href={entryPath(resource)}>
          <div class="resource-card__chips"><Chip tone="accent">{resource.data.topic}</Chip><Chip>{statusLabels[resource.data.status] || resource.data.status}</Chip></div>
          <h2>{resource.data.title}</h2>
          <p>{resource.data.description}</p>
          <dl class="resource-card__facts">
            <div><dt>来源</dt><dd>{resource.data.publisher || resource.data.author || new URL(resource.data.sourceUrl).hostname}</dd></div>
            <div><dt>最近复核</dt><dd>{resource.data.lastReviewedAt.toISOString().slice(0, 10)}</dd></div>
          </dl>
          <div class="resource-card__progress"><span>进度</span><strong>{resource.data.progress}%</strong><div><i style={`width:${resource.data.progress}%`}></i></div></div>
          <footer><span>{typeLabels[resource.data.resourceType] || resource.data.resourceType}</span><span>{statusLabels[resource.data.status] || resource.data.status}</span></footer>
        </a>
      </article>
    ))}
  </div>
  <p id="resource-empty" class="resource-empty" hidden>没有符合当前条件的资料。可以清空筛选后再试。</p>
</section>

<script>
  function setupResourceFilter() {
    const form = document.getElementById("resource-filter") as HTMLFormElement | null;
    if (!form || form.dataset.bound === "true") return;
    form.dataset.bound = "true";
    const query = document.getElementById("resource-query") as HTMLInputElement;
    const topic = document.getElementById("resource-topic") as HTMLSelectElement;
    const type = document.getElementById("resource-type") as HTMLSelectElement;
    const status = document.getElementById("resource-status") as HTMLSelectElement;
    const count = document.getElementById("resource-count");
    const empty = document.getElementById("resource-empty");
    const cards = [...document.querySelectorAll<HTMLElement>("[data-resource-card]")];

    const fromUrl = () => {
      const params = new URLSearchParams(location.search);
      query.value = params.get("q") || "";
      topic.value = params.get("topic") || "";
      type.value = params.get("type") || "";
      status.value = params.get("status") || "";
    };

    const apply = () => {
      const needle = query.value.trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        const show = (!needle || card.dataset.title?.includes(needle))
          && (!topic.value || card.dataset.topic === topic.value)
          && (!type.value || card.dataset.type === type.value)
          && (!status.value || card.dataset.status === status.value);
        card.hidden = !show;
        if (show) visible += 1;
      });
      if (count) count.textContent = `${visible} 条资料`;
      if (empty) empty.hidden = visible > 0;
      const params = new URLSearchParams();
      if (query.value.trim()) params.set("q", query.value.trim());
      if (topic.value) params.set("topic", topic.value);
      if (type.value) params.set("type", type.value);
      if (status.value) params.set("status", status.value);
      history.replaceState({}, "", `${location.pathname}${params.size ? `?${params}` : ""}`);
    };

    fromUrl();
    apply();
    form.addEventListener("input", apply);
    form.addEventListener("change", apply);
    form.addEventListener("reset", () => requestAnimationFrame(apply));
    window.addEventListener("popstate", () => { fromUrl(); apply(); });
  }

  document.addEventListener("astro:page-load", setupResourceFilter);
</script>

<style>
  .resource-filter { display: grid; grid-template-columns: minmax(14rem, 1.5fr) repeat(3, minmax(9rem, 1fr)) auto; gap: var(--space-3); align-items: end; margin-bottom: var(--space-7); padding: var(--space-6); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface-solid); }
  .resource-filter__heading { display: flex; grid-column: 1 / -1; align-items: end; justify-content: space-between; gap: var(--space-5); margin-bottom: var(--space-3); }
  .resource-filter__heading p { margin: 0; color: var(--color-ink-tertiary); font-size: var(--text-small); }
  .resource-filter__heading div > p { color: var(--color-accent); font-weight: 720; }
  .resource-filter__heading h2 { margin: var(--space-1) 0 0; font-size: var(--text-title); letter-spacing: -0.035em; }
  label { display: grid; gap: var(--space-2); color: var(--color-ink-secondary); font-size: var(--text-small); font-weight: 650; }
  input, select { width: 100%; min-height: 2.75rem; padding-inline: var(--space-3); border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-canvas); color: var(--color-ink); }
  button { min-height: 2.75rem; padding-inline: var(--space-4); border: 1px solid var(--color-border); border-radius: var(--radius-pill); background: transparent; color: var(--color-ink); cursor: pointer; }
  .resource-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); }
  article[hidden] { display: none; }
  article > a { display: flex; min-height: 24rem; flex-direction: column; padding: var(--space-6); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface-solid); color: var(--color-ink); text-decoration: none; transition: transform var(--duration-normal), box-shadow var(--duration-normal); }
  article > a:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .resource-card__chips { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  article h2 { margin: var(--space-7) 0 var(--space-4); font-size: var(--text-title); letter-spacing: -0.035em; line-height: 1.15; }
  article p { margin: 0; color: var(--color-ink-secondary); }
  .resource-card__facts { display: grid; gap: var(--space-2); margin: var(--space-5) 0 0; }
  .resource-card__facts div { display: grid; grid-template-columns: 5rem minmax(0, 1fr); gap: var(--space-3); }
  .resource-card__facts dt { color: var(--color-ink-tertiary); font-size: var(--text-small); }
  .resource-card__facts dd { margin: 0; color: var(--color-ink-secondary); font-size: var(--text-small); }
  .resource-card__progress { display: grid; grid-template-columns: 1fr auto; gap: var(--space-2); margin-top: auto; padding-top: var(--space-7); color: var(--color-ink-tertiary); font-size: var(--text-small); }
  .resource-card__progress div { grid-column: 1 / -1; height: 0.25rem; overflow: hidden; border-radius: var(--radius-pill); background: var(--color-surface-subtle); }
  .resource-card__progress i { display: block; height: 100%; border-radius: inherit; background: var(--color-accent); }
  article footer { display: flex; justify-content: space-between; align-items: center; margin-top: var(--space-4); color: var(--color-ink-tertiary); font-size: var(--text-small); }
  .resource-empty { padding: var(--space-8); border: 1px dashed var(--color-border); border-radius: var(--radius-lg); color: var(--color-ink-secondary); text-align: center; }
  @media (max-width: 900px) { .resource-filter { grid-template-columns: repeat(2, minmax(0, 1fr)); } .resource-grid { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .resource-filter { grid-template-columns: 1fr; padding: var(--space-5); } .resource-filter__heading { align-items: flex-start; flex-direction: column; } article > a { min-height: 21rem; } }
</style>
