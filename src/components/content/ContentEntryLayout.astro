---
import MainPageLayout from "@layouts/MainPageLayout.astro";
import Markdown from "@components/misc/Markdown.astro";
import Chip from "@components/ui/Chip.astro";
import FabMenu from "@components/control/FabMenu.astro";
import { formatFullDate } from "@/utils/time";

interface Props {
  pageTitle: string;
  title: string;
  description: string;
  eyebrow: string;
  lang?: string;
  pubDate?: Date;
  dateLabel?: string;
  topic?: string;
  tags?: string[];
}

const { pageTitle, title, description, eyebrow, lang = "zh-cn", pubDate, dateLabel, topic, tags = [] } = Astro.props;
---

<MainPageLayout title={pageTitle} lang={lang} description={description}>
  <article class="content-entry reading-shell">
    <header class="content-entry__header">
      <p class="content-entry__eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="content-entry__description">{description}</p>
      <div class="content-entry__meta">
        {dateLabel && <span>{dateLabel}</span>}
        {!dateLabel && pubDate && <time datetime={pubDate.toISOString()}>{formatFullDate(pubDate, lang)}</time>}
        {topic && <Chip tone="accent">{topic}</Chip>}
        {tags.map((tag) => <Chip>{tag}</Chip>)}
      </div>
      {Astro.slots.has("aside") && <div class="content-entry__aside"><slot name="aside" /></div>}
    </header>
    <Markdown class="content-entry__body markdown-content onload-animation"><slot /></Markdown>
  </article>
  <FabMenu showBackBottom={true} />
</MainPageLayout>

<style>
  .content-entry { padding-top: clamp(5rem, 10vw, 8rem); }
  .content-entry__header { padding-bottom: clamp(2.5rem, 6vw, 4.5rem); border-bottom: 1px solid var(--color-border); }
  .content-entry__eyebrow { margin: 0 0 var(--space-4); color: var(--color-accent); font-size: var(--text-small); font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  h1 { max-width: 17ch; margin: 0; font-family: var(--font-display); font-size: var(--text-display-md); line-height: var(--leading-heading); letter-spacing: var(--tracking-tight); }
  .content-entry__description { max-width: 42rem; margin: var(--space-5) 0 0; color: var(--color-ink-secondary); font-size: clamp(1rem, 1.5vw, 1.2rem); }
  .content-entry__meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); margin-top: var(--space-5); color: var(--color-ink-tertiary); font-size: var(--text-small); }
  .content-entry__aside { margin-top: var(--space-5); }
  .content-entry__body { margin-top: clamp(2.5rem, 6vw, 4.5rem); }
</style>
