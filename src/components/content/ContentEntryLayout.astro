---
import MainPageLayout from "@layouts/MainPageLayout.astro";
import CinematicHero from "@components/ui/CinematicHero.astro";
import FloatingPanel from "@components/ui/FloatingPanel.astro";
import Markdown from "@components/misc/Markdown.astro";
import FabMenu from "@components/control/FabMenu.astro";
import { formatFullDate } from "@/utils/time";

interface Props {
  pageTitle: string;
  title: string;
  description: string;
  eyebrow: string;
  lang?: string;
  pubDate?: Date;
  dateLabel?: string;
  topic?: string;
  tags?: string[];
  staticTags?: string[];
  backHref?: string;
  backLabel?: string;
  variant?: "default" | "resource";
}
const { pageTitle, title, description, eyebrow, lang = "zh-cn", pubDate, dateLabel, topic, tags = [], staticTags = [], backHref, backLabel, variant = "default" } = Astro.props;
---

<MainPageLayout title={pageTitle} lang={lang} description={description} type="article" publishedTime={pubDate}>
  <CinematicHero title={title} description={description}>
    <Fragment slot="meta"><span>{eyebrow}</span>{dateLabel && <span>{dateLabel}</span>}{!dateLabel && pubDate && <time datetime={pubDate.toISOString()}>{formatFullDate(pubDate, lang)}</time>}{topic && <span>{topic}</span>}</Fragment>
  </CinematicHero>
  <FloatingPanel id="page-content" class="entry-panel">
    <article class:list={["content-entry", variant === "resource" && "content-entry--resource"]}>
      <span class="sr-only" data-pagefind-meta={`kind:${eyebrow}`}></span>
      {topic && <span class="sr-only" data-pagefind-meta={`topic:${topic}`}></span>}
      {pubDate && <span class="sr-only" data-pagefind-meta={`date:${pubDate.toISOString().slice(0, 10)}`}></span>}
      <div class="content-entry__top">
        {backHref && <a class="content-entry__back" href={backHref}>← {backLabel || "返回"}</a>}
        <div class="content-entry__tags">{tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`}>#{tag}</a>)}{staticTags.map((tag) => <span>{tag}</span>)}</div>
      </div>
      {Astro.slots.has("aside") && <aside class="content-entry__aside"><slot name="aside" /></aside>}
      <Markdown class="content-entry__body markdown-content onload-animation"><slot /></Markdown>
      {Astro.slots.has("after") && <div class="content-entry__after"><slot name="after" /></div>}
    </article>
  </FloatingPanel>
  <FabMenu showBackBottom={true} />
</MainPageLayout>

<style>
  :global(.entry-panel) { width: min(1120px, calc(100% - 2rem)); }
  .content-entry { width: min(790px, 100%); margin: 0 auto; }
  .content-entry__top { display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: .75rem; padding-bottom: 1.2rem; border-bottom: 1px solid var(--color-border); }
  .content-entry__back { color: var(--color-ink-secondary); font-size: .87rem; text-decoration: none; }
  .content-entry__back:hover { color: var(--color-accent); }
  .content-entry__tags { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .5rem; }
  .content-entry__tags a, .content-entry__tags span { padding: .2rem .55rem; border-radius: 999px; background: var(--color-accent-soft); color: var(--color-accent); font-size: .75rem; text-decoration: none; }
  .content-entry__tags a:hover { text-decoration: underline; }
  .content-entry__aside { margin-top: 1.5rem; }
  .content-entry__body { margin-top: 2rem; }
  .content-entry__after { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border); }
  @media (max-width: 720px) { :global(.entry-panel) { width: calc(100% - 1.25rem); }.content-entry__tags { justify-content: flex-start; } }
</style>
