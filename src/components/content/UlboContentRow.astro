---
interface Props {
  href: string;
  title: string;
  description?: string;
  kind?: string;
  topic?: string;
  date?: string;
  tags?: string[];
}
const { href, title, description, kind, topic, date, tags = [] } = Astro.props;
---

<a class="ulbo-content-row" href={href}>
  <div class="ulbo-content-row__body">
    <h3>{title}</h3>
    {description && <p>{description}</p>}
    <div class="ulbo-content-row__tags">{tags.slice(0, 3).map((tag) => <span>#{tag}</span>)}</div>
  </div>
  <div class="ulbo-content-row__meta">
    {kind && <span>{kind}</span>}
    {topic && <span>{topic}</span>}
    {date && <time>{date}</time>}
  </div>
</a>

<style>
  .ulbo-content-row { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; margin: 0 -.6rem; padding: 1.2rem .8rem; border-bottom: 1px solid var(--color-border); border-radius: 10px; color: var(--color-ink); text-decoration: none; transition: background-color .2s, transform .2s; }
  .ulbo-content-row::before { position: absolute; top: 18%; bottom: 18%; left: 0; width: 3px; border-radius: 3px; background: var(--color-accent); content: ""; transform: scaleY(0); transition: transform .2s; }
  .ulbo-content-row:hover { background: var(--color-surface-subtle); transform: translateX(4px); }
  .ulbo-content-row:hover::before { transform: scaleY(1); }
  .ulbo-content-row__body { min-width: 0; }
  h3 { margin: 0; font-size: clamp(1.05rem, 1.8vw, 1.35rem); font-weight: 650; line-height: 1.4; }
  p { display: -webkit-box; max-width: 50rem; margin: .4rem 0 0; overflow: hidden; color: var(--color-ink-secondary); font-size: .9rem; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  .ulbo-content-row__tags { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: .6rem; color: var(--color-accent); font-size: .77rem; }
  .ulbo-content-row__meta { display: grid; flex: 0 0 9rem; gap: .15rem; color: var(--color-ink-tertiary); font-size: .78rem; text-align: right; }
  @media (max-width: 600px) { .ulbo-content-row { align-items: flex-start; flex-direction: column; gap: .5rem; }.ulbo-content-row__meta { display: flex; flex: auto; flex-wrap: wrap; gap: .3rem .85rem; text-align: left; } }
  @media (prefers-reduced-motion: reduce) { .ulbo-content-row, .ulbo-content-row::before { transition: none; } }
</style>
