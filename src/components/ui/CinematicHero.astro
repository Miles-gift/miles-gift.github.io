---
interface Props {
  title: string;
  description?: string;
  size?: "full" | "compact";
  image?: string;
  class?: string;
}

const {
  title,
  description,
  size = "compact",
  image = "/visual/forest-path-hero.webp",
  class: className = "",
} = Astro.props;
---

<section class:list={["cinematic-hero", `cinematic-hero--${size}`, className]} style={`--hero-image: url('${image}')`} aria-labelledby="hero-title">
  <div class="cinematic-hero__image" aria-hidden="true"></div>
  <div class="cinematic-hero__shade" aria-hidden="true"></div>
  <div class="cinematic-hero__content">
    <h1 id="hero-title">{title}</h1>
    {description && <p>{description}</p>}
    {Astro.slots.has("meta") && <div class="cinematic-hero__meta"><slot name="meta" /></div>}
  </div>
  {size === "full" && <a class="cinematic-hero__scroll" href="#page-content" aria-label="向下浏览内容"><span aria-hidden="true">⌄</span></a>}
</section>

<style>
  .cinematic-hero { position: relative; isolation: isolate; display: grid; min-height: min(58svh, 42rem); place-items: center; overflow: hidden; background: #172322; color: #fff; }
  .cinematic-hero--full { min-height: 100svh; min-height: 100dvh; }
  .cinematic-hero__image, .cinematic-hero__shade { position: absolute; inset: 0; z-index: -1; }
  .cinematic-hero__image { background-image: var(--hero-image); background-position: center; background-size: cover; }
  .cinematic-hero__shade { background: linear-gradient(180deg, rgb(5 15 18 / .47) 0%, rgb(7 18 21 / .34) 37%, rgb(6 16 19 / .60) 100%); }
  .cinematic-hero__content { width: min(90vw, 54rem); padding: 7rem 1rem 6rem; text-align: center; }
  h1 { margin: 0; color: #fff; font-family: var(--font-display); font-size: clamp(2.25rem, 5.1vw, 4.65rem); font-weight: 650; letter-spacing: -.045em; line-height: 1.2; text-wrap: balance; text-shadow: 0 2px 25px rgb(0 0 0 / .35); }
  p { max-width: 36rem; margin: 1.1rem auto 0; color: rgb(255 255 255 / .90); font-size: clamp(1rem, 1.75vw, 1.2rem); line-height: 1.7; text-wrap: balance; }
  .cinematic-hero__meta { display: flex; flex-wrap: wrap; justify-content: center; gap: .6rem 1.1rem; margin-top: 1.4rem; color: rgb(255 255 255 / .9); font-size: .9rem; }
  .cinematic-hero__scroll { position: absolute; bottom: 1.75rem; left: 50%; display: grid; width: 2.8rem; height: 2.8rem; place-items: center; border: 1px solid rgb(255 255 255 / .65); border-radius: 50%; color: white; font-size: 2rem; line-height: 1; text-decoration: none; transform: translateX(-50%); transition: background-color .2s, transform .2s; }
  .cinematic-hero__scroll:hover { background: rgb(255 255 255 / .16); transform: translateX(-50%) translateY(3px); }
  .cinematic-hero--compact .cinematic-hero__content { padding-block: 8rem 6.5rem; }
  @media (max-width: 720px) {
    .cinematic-hero { min-height: min(52svh, 34rem); }
    .cinematic-hero--full { min-height: 100svh; min-height: 100dvh; }
    .cinematic-hero__image { background-position: 51% center; }
    .cinematic-hero__content { padding-inline: .5rem; }
    .cinematic-hero--compact .cinematic-hero__content { padding-block: 7rem 5.75rem; }
  }
  @media (prefers-reduced-motion: reduce) { .cinematic-hero__scroll { transition: none; } }
</style>
