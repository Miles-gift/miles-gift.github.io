---
interface Props { id?: string; class?: string; }
const { id, class: className = "" } = Astro.props;
---

<div id={id} class:list={["ulbo-panel", className]}><slot /></div>

<style>
  .ulbo-panel { position: relative; z-index: 2; width: min(1200px, calc(100% - 2rem)); margin: -5.5rem auto 0; padding: clamp(1.25rem, 3.5vw, 2.75rem); border: 1px solid var(--color-border); border-radius: 18px; background: var(--color-surface-solid); box-shadow: var(--shadow-sm); }
  @media (max-width: 720px) { .ulbo-panel { width: calc(100% - 1.25rem); margin-top: -3rem; border-radius: 14px; } }
</style>
