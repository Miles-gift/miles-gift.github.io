---
import "@styles/global.css";
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";
import ThemeIcon from "./control/ThemeIcon.astro";
import IconButton from "./ui/IconButton.astro";
import { baseUrl, getRelativeLocaleUrl } from "@utils/url-utils";
import { i18n } from "astro:config/client";

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const indexPage = getRelativeLocaleUrl(currentLang, "/");
const currentPath = Astro.url.pathname;
const navItems = [
  { href: indexPage, label: "首页", mark: "01" },
  { href: getRelativeLocaleUrl(currentLang, "/articles/"), label: "文章", mark: "02" },
  { href: getRelativeLocaleUrl(currentLang, "/resources/"), label: "资料库", mark: "03" },
  { href: getRelativeLocaleUrl(currentLang, "/journey/"), label: "旅程", mark: "04" },
  { href: getRelativeLocaleUrl(currentLang, "/about/"), label: "关于", mark: "05" },
];
const isActive = (path: string) => path === indexPage ? currentPath === path : currentPath.startsWith(path);
---

<header id="main-header" class="site-header">
  <div class="site-header__shell stage-shell">
    <a href={indexPage} class="site-brand" aria-label={`${siteConfig.title} 首页`}>
      <img src="/brand/yoyo-trail.svg" width="36" height="36" alt="" />
      <span>yoyo<span class="site-brand__long">的旅行日记</span></span>
    </a>

    <nav class="desktop-nav" aria-label="主导航">
      {navItems.map((item) => (
        <a href={item.href} class:list={[isActive(item.href) && "is-active"]} aria-current={isActive(item.href) ? "page" : undefined}>
          <small>{item.mark}</small>{item.label}
        </a>
      ))}
    </nav>

    <div class="site-header__tools">
      <IconButton id="search-button" label="搜索"><Icon name="fa6-solid:magnifying-glass" class="w-4 h-4" /></IconButton>
      <ThemeIcon class="ui-icon-button" />
      <IconButton id="mobile-menu-button" label="打开菜单" controls="mobile-menu-container" expanded={false} class="mobile-menu-trigger">
        <Icon name="fa6-solid:bars" class="w-5 h-5" />
      </IconButton>
    </div>
  </div>
</header>

<div id="mobile-menu-container" class="mobile-menu" aria-hidden="true">
  <button id="mobile-menu-overlay" class="mobile-menu__overlay" aria-label="关闭菜单" tabindex="-1"></button>
  <aside id="mobile-menu-drawer" class="mobile-menu__drawer" role="dialog" aria-modal="true" aria-label="站点导航">
    <div class="mobile-menu__head">
      <a href={indexPage} class="site-brand"><img src="/brand/yoyo-trail.svg" width="36" height="36" alt="" /><span>yoyo的旅行日记</span></a>
      <IconButton id="mobile-menu-close" label="关闭菜单"><Icon name="fa6-solid:xmark" class="w-5 h-5" /></IconButton>
    </div>
    <p class="mobile-menu__note">Pick a trail, and keep walking.</p>
    <nav class="mobile-nav" aria-label="移动端主导航">
      {navItems.map((item) => (
        <a href={item.href} class:list={[isActive(item.href) && "is-active"]} aria-current={isActive(item.href) ? "page" : undefined}>
          <small>{item.mark}</small><span>{item.label}</span>
        </a>
      ))}
    </nav>
    <div class="mobile-menu__footer">学习在发生，记录也在生长。</div>
  </aside>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    height: var(--header-height);
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-canvas) 80%, transparent);
    -webkit-backdrop-filter: blur(var(--blur-surface)) saturate(125%);
    transition: transform var(--duration-normal) var(--ease-standard);
  }
  @supports (backdrop-filter: blur(1px)) { .site-header { backdrop-filter: blur(var(--blur-surface)) saturate(125%); } }
  .site-header__shell { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; height: 100%; }
  .site-brand { display: inline-flex; width: max-content; align-items: center; gap: .65rem; color: var(--color-ink); font-family: var(--font-display); font-size: 1.02rem; font-weight: 600; text-decoration: none; }
  .site-brand img { border-radius: .7rem; box-shadow: 0 5px 16px rgb(23 43 58 / .12); transition: transform var(--duration-normal) var(--ease-emphasized); }
  .site-brand:hover img { transform: rotate(-7deg) scale(1.04); }
  .site-brand__long { margin-left: .05em; color: var(--color-ink-secondary); font-weight: 400; }
  .desktop-nav { display: flex; align-items: stretch; gap: 1.35rem; align-self: stretch; }
  .desktop-nav a { position: relative; display: flex; align-items: center; gap: .34rem; color: var(--color-ink-secondary); font-size: .9rem; font-weight: 600; text-decoration: none; transition: color var(--duration-fast); }
  .desktop-nav a::after { position: absolute; right: 0; bottom: -1px; left: 0; height: 2px; background: var(--color-annotation); content: ""; transform: scaleX(0); transform-origin: left; transition: transform var(--duration-normal) var(--ease-emphasized); }
  .desktop-nav a:hover, .desktop-nav a.is-active { color: var(--color-ink); }
  .desktop-nav a:hover::after, .desktop-nav a.is-active::after { transform: scaleX(1); }
  .desktop-nav small { color: var(--color-annotation); font-family: var(--font-editorial); font-size: .66rem; font-weight: 600; }
  .site-header__tools { display: flex; justify-content: flex-end; gap: var(--space-2); }
  :global(.mobile-menu-trigger) { display: none; }
  .mobile-menu { position: fixed; inset: 0; z-index: var(--z-overlay); visibility: hidden; pointer-events: none; }
  .mobile-menu.is-open { visibility: visible; pointer-events: auto; }
  .mobile-menu__overlay { position: absolute; inset: 0; border: 0; background: rgb(8 18 24 / .58); opacity: 0; transition: opacity var(--duration-normal); }
  .mobile-menu.is-open .mobile-menu__overlay { opacity: 1; }
  .mobile-menu__drawer { position: absolute; inset: 0 0 0 auto; display: flex; width: min(88vw, 24rem); flex-direction: column; padding: var(--space-5); border-left: 1px solid var(--color-border); background: var(--color-canvas-raised); box-shadow: var(--shadow-lg); transform: translateX(102%); transition: transform var(--duration-normal) var(--ease-emphasized); }
  .mobile-menu.is-open .mobile-menu__drawer { transform: translateX(0); }
  .mobile-menu__head { display: flex; align-items: center; justify-content: space-between; padding-bottom: var(--space-5); border-bottom: 1px solid var(--color-border); }
  .mobile-menu__note { margin: var(--space-6) 0 var(--space-4); color: var(--color-annotation); font-family: var(--font-editorial); font-size: 1.3rem; font-style: italic; }
  .mobile-nav { display: grid; }
  .mobile-nav a { display: grid; grid-template-columns: 2.4rem 1fr; align-items: baseline; padding: .85rem 0; border-bottom: 1px dashed var(--color-border); color: var(--color-ink); font-family: var(--font-display); font-size: 1.55rem; text-decoration: none; }
  .mobile-nav small { color: var(--color-annotation); font-family: var(--font-editorial); font-size: .8rem; }
  .mobile-nav a.is-active span { text-decoration: underline wavy var(--color-annotation); text-underline-offset: .35rem; }
  .mobile-menu__footer { margin-top: auto; padding-top: var(--space-5); border-top: 1px solid var(--color-border); color: var(--color-ink-tertiary); font-size: var(--text-small); }
  @media (max-width: 850px) {
    .site-header__shell { grid-template-columns: 1fr auto; }
    .desktop-nav { display: none; }
    :global(.mobile-menu-trigger) { display: inline-grid; }
    .header-hidden { transform: translateY(-102%); }
  }
  @media (max-width: 430px) { .site-brand__long { display: none; } }
</style>

<script>
  function initSiteHeader() {
    const menuButton = document.getElementById("mobile-menu-button");
    const closeButton = document.getElementById("mobile-menu-close");
    const container = document.getElementById("mobile-menu-container");
    const overlay = document.getElementById("mobile-menu-overlay");
    if (!menuButton || !container || menuButton.dataset.bound === "true") return;
    menuButton.dataset.bound = "true";
    const openMenu = () => {
      container.classList.add("is-open");
      container.setAttribute("aria-hidden", "false");
      menuButton.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
      window.requestAnimationFrame(() => closeButton?.focus());
    };
    const closeMenu = () => {
      container.classList.remove("is-open");
      container.setAttribute("aria-hidden", "true");
      menuButton.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
      menuButton.focus();
    };
    menuButton.addEventListener("click", openMenu);
    closeButton?.addEventListener("click", closeMenu);
    overlay?.addEventListener("click", closeMenu);
    container.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
    document.addEventListener("keydown", (event) => { if (event.key === "Escape" && container.classList.contains("is-open")) closeMenu(); });
  }

  function initHeaderScroll() {
    const header = document.getElementById("main-header");
    if (!header || header.dataset.scrollBound === "true") return;
    header.dataset.scrollBound = "true";
    let previous = window.scrollY;
    window.addEventListener("scroll", () => {
      const current = window.scrollY;
      if (window.innerWidth < 851 && current > 100 && current > previous) header.classList.add("header-hidden");
      else header.classList.remove("header-hidden");
      previous = current;
    }, { passive: true });
  }
  document.addEventListener("astro:page-load", () => { initSiteHeader(); initHeaderScroll(); });
</script>

{import.meta.env.PROD && (
  <script is:inline define:vars={{ scriptUrl: baseUrl("/pagefind/pagefind.js") }}>
    async function loadAndSearch() {
      if (window.pagefind && typeof window.pagefind.search === "function") return;
      if (window.pagefindLoading) return;
      window.pagefindLoading = true;
      try {
        const pagefind = await import(scriptUrl);
        await pagefind.options({ excerptLength: 20 });
        window.pagefind = pagefind;
        document.dispatchEvent(new CustomEvent("pagefind-ready"));
      } catch (error) {
        console.error("Pagefind 加载失败:", error);
      } finally {
        window.pagefindLoading = false;
      }
    }
    function attachSearchListener() {
      const button = document.getElementById("search-button");
      if (button && button.dataset.searchBound !== "true") {
        button.dataset.searchBound = "true";
        button.addEventListener("click", loadAndSearch, { once: true });
      }
    }
    document.addEventListener("astro:page-load", attachSearchListener);
  </script>
)}
