---
import CinematicHero from "@components/ui/CinematicHero.astro";
import FloatingPanel from "@components/ui/FloatingPanel.astro";
import { entryPath, getArticleEntrySort, getPublicEntries } from "@utils/content-utils";
import { formatFullDate } from "@utils/time";

const lang = Astro.currentLocale || "zh-cn";
const articles = await getArticleEntrySort(lang);
const resources = await getPublicEntries("resources");
const thoughts = await getPublicEntries("thoughts");
const journey = await getPublicEntries("journey");
const count = articles.length + resources.length + thoughts.length + journey.length;
const topics = new Set([...articles, ...resources, ...thoughts].map((entry) => entry.data.topic));
const featured = articles.find((entry) => entry.data.featured) || articles[0];

const updates = [
  ...articles.map((entry) => ({ title: entry.data.title, description: entry.data.description, date: entry.data.pubDate, kind: "文章", topic: entry.data.topic, href: entryPath(entry) })),
  ...resources.map((entry) => ({ title: entry.data.title, description: entry.data.description, date: entry.data.pubDate, kind: "资料", topic: entry.data.topic, href: entryPath(entry) })),
  ...thoughts.map((entry) => ({ title: entry.data.title, description: entry.data.description, date: entry.data.pubDate, kind: "想法", topic: entry.data.topic, href: entryPath(entry) })),
  ...journey.map((entry) => ({ title: entry.data.title, description: entry.data.summary, date: entry.data.pubDate, kind: "旅程", topic: entry.data.kind, href: entryPath(entry) })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf()).slice(0, 9);

const sections = [
  { label: "文章", href: "/articles/", description: "写长一点，想清楚一点", count: articles.length },
  { label: "资料库", href: "/resources/", description: "持续整理的学习资料", count: resources.length },
  { label: "短想法", href: "/articles/#quick-notes", description: "还值得继续追问的念头", count: thoughts.length },
  { label: "旅程", href: "/journey/", description: "学习、服务与成长的坐标", count: journey.length },
];
---

<CinematicHero size="full" title="沿着知识去旅行" description="把学习、生活与沿途风景写下来。" />

<div class="home-hub">
  <FloatingPanel id="page-content" class="home-hub__panel">
    <section class="home-hub__intro" aria-labelledby="home-intro-title">
      <div><h2 id="home-intro-title">从这里继续出发</h2><p>这里收着已写下的文章、学习资料、短想法与旅程记录。按主题翻阅，或从最近一次更新开始。</p></div>
      <div class="home-hub__stats" aria-label="站点内容概览">
        <div><strong>{count}</strong><span>条记录</span></div><div><strong>{topics.size}</strong><span>个主题</span></div><div><strong>4</strong><span>类内容</span></div>
      </div>
    </section>

    {featured && <section class="home-hub__featured" aria-labelledby="home-featured-title">
      <div class="home-hub__section-heading"><h2 id="home-featured-title">从一篇文章开始</h2><a href="/articles/">全部文章</a></div>
      <a class="home-hub__featured-link" href={entryPath(featured)}><div><span>{featured.data.topic}</span><h3>{featured.data.title}</h3><p>{featured.data.description}</p></div><span aria-hidden="true">↗</span></a>
    </section>}

    <section class="home-hub__updates" aria-labelledby="home-updates-title">
      <div class="home-hub__section-heading"><h2 id="home-updates-title">最近更新</h2><a href="/archives/">查看归档</a></div>
      <div class="home-hub__list">
        {updates.map((item) => <article class="home-hub__item"><a href={item.href}><div><span class="home-hub__kind">{item.kind}</span><h3>{item.title}</h3><p>{item.description}</p></div><div class="home-hub__item-meta"><time datetime={item.date.toISOString()}>{formatFullDate(item.date, lang)}</time><span>{item.topic}</span></div></a></article>)}
      </div>
    </section>

    <section class="home-hub__sections" aria-labelledby="home-sections-title"><div class="home-hub__section-heading"><h2 id="home-sections-title">按内容浏览</h2></div><div class="home-hub__section-grid">{sections.map((section) => <a href={section.href}><span>{section.label}</span><strong>{section.count}</strong><small>{section.description}</small></a>)}</div></section>
  </FloatingPanel>
</div>

<style>
  .home-hub { padding-bottom: 1rem; background: var(--color-canvas); }
  .home-hub__intro { display: grid; grid-template-columns: 1fr .85fr; align-items: center; gap: clamp(2rem, 6vw, 5rem); padding-bottom: 2rem; }
  .home-hub__intro h2 { margin: 0; font-size: clamp(1.5rem, 2.8vw, 2.15rem); line-height: 1.25; }
  .home-hub__intro p { max-width: 38rem; margin: .75rem 0 0; color: var(--color-ink-secondary); }
  .home-hub__stats { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--color-border); border-radius: 10px; overflow: hidden; }
  .home-hub__stats div { display: grid; justify-items: center; align-content: center; gap: .15rem; min-height: 6rem; padding: .7rem; }
  .home-hub__stats div + div { border-left: 1px solid var(--color-border); }
  .home-hub__stats strong { font-family: var(--font-display); font-size: clamp(1.35rem, 2vw, 1.85rem); }
  .home-hub__stats span { color: var(--color-ink-secondary); font-size: .8rem; }
  .home-hub__featured, .home-hub__updates, .home-hub__sections { padding-top: 2.25rem; border-top: 1px solid var(--color-border); }
  .home-hub__section-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .home-hub__section-heading h2 { margin: 0; font-size: 1.4rem; }
  .home-hub__section-heading a { color: var(--color-ink-secondary); font-size: .88rem; text-decoration: none; }
  .home-hub__section-heading a:hover { color: var(--color-accent); }
  .home-hub__featured-link { display: flex; justify-content: space-between; gap: 1.5rem; padding: 1.5rem; border: 1px solid var(--color-border); border-radius: 12px; background: var(--color-surface-subtle); color: var(--color-ink); text-decoration: none; }
  .home-hub__featured-link:hover { border-color: var(--color-accent); }
  .home-hub__featured-link div > span { color: var(--color-accent); font-size: .78rem; font-weight: 650; }
  .home-hub__featured-link h3 { margin: .4rem 0; font-size: clamp(1.35rem, 2.4vw, 1.9rem); }
  .home-hub__featured-link p { max-width: 55rem; margin: 0; color: var(--color-ink-secondary); }
  .home-hub__featured-link > span { color: var(--color-accent); font-size: 1.4rem; }
  .home-hub__updates, .home-hub__sections { margin-top: 2.25rem; }
  .home-hub__list { border-top: 1px solid var(--color-border); }
  .home-hub__item { position: relative; border-bottom: 1px solid var(--color-border); }
  .home-hub__item::before { position: absolute; top: 17%; bottom: 17%; left: 0; width: 3px; border-radius: 3px; background: var(--color-accent); content: ""; transform: scaleY(0); transition: transform .2s; }
  .home-hub__item:hover::before { transform: scaleY(1); }
  .home-hub__item > a { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 1.2rem .9rem; border-radius: 9px; color: var(--color-ink); text-decoration: none; transition: background-color .2s, padding-left .2s; }
  .home-hub__item > a:hover { padding-left: 1.25rem; background: var(--color-surface-subtle); }
  .home-hub__kind { color: var(--color-accent); font-size: .76rem; }
  .home-hub__item h3 { margin: .2rem 0; font-size: 1.15rem; line-height: 1.35; }
  .home-hub__item p { display: -webkit-box; max-width: 45rem; margin: .2rem 0 0; overflow: hidden; color: var(--color-ink-secondary); font-size: .87rem; line-height: 1.5; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
  .home-hub__item-meta { display: grid; flex: 0 0 9rem; gap: .15rem; color: var(--color-ink-tertiary); font-size: .8rem; text-align: right; }
  .home-hub__section-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: .75rem; }
  .home-hub__section-grid a { display: grid; grid-template-columns: 1fr auto; align-content: start; gap: .2rem; min-height: 7.5rem; padding: 1rem; border: 1px solid var(--color-border); border-radius: 10px; color: var(--color-ink); text-decoration: none; }
  .home-hub__section-grid a:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .home-hub__section-grid strong { color: var(--color-ink-tertiary); font-weight: 500; }
  .home-hub__section-grid small { grid-column: 1 / -1; color: var(--color-ink-secondary); }
  @media (max-width: 800px) { .home-hub__intro { grid-template-columns: 1fr; }.home-hub__section-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 580px) { .home-hub__item > a { align-items: flex-start; flex-direction: column; gap: .5rem; }.home-hub__item-meta { display: flex; flex: auto; gap: 1rem; text-align: left; }.home-hub__stats div { min-height: 5rem; }.home-hub__section-grid { grid-template-columns: 1fr 1fr; } }
  @media (prefers-reduced-motion: reduce) { .home-hub__item::before, .home-hub__item > a { transition: none; } }
</style>
