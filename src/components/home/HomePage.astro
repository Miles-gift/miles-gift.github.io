---
import { entryPath, getArticleEntrySort, getPublicEntries } from "@utils/content-utils";
import { formatFullDate } from "@utils/time";

const lang = Astro.currentLocale || "zh-cn";
const articles = await getArticleEntrySort(lang);
const resources = (await getPublicEntries("resources")).sort((a, b) => b.data.lastReviewedAt.valueOf() - a.data.lastReviewedAt.valueOf());
const thoughts = (await getPublicEntries("thoughts")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const journey = (await getPublicEntries("journey")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featuredArticle = articles.find((item) => item.data.featured) || articles[0];
const latestArticles = articles.slice(0, 3);
const latestThoughts = thoughts.slice(0, 3);
const latestJourney = journey.slice(0, 3);
const topics = [...new Set(resources.map((item) => item.data.topic))].sort();
---

<main class="home stage-shell">
  <section class="home-intro" aria-labelledby="home-title">
    <p class="eyebrow">YOYO · PERSONAL NOTES</p>
    <h1 id="home-title">记录学习，也记录<br /><span>一路上的想法。</span></h1>
    <div class="home-intro__bottom">
      <p>这里收集文章、学习资料、短想法与个人旅程。</p>
      <a class="primary-link" href="/articles/">从文章开始 <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <nav class="home-sections" aria-label="内容栏目">
    <a href="/articles/"><span>01</span><strong>文章</strong><small>{articles.length} 篇</small></a>
    <a href="/resources/"><span>02</span><strong>资料</strong><small>{resources.length} 条</small></a>
    <a href="/articles/#quick-notes"><span>03</span><strong>想法</strong><small>{thoughts.length} 条</small></a>
    <a href="/journey/"><span>04</span><strong>旅程</strong><small>{journey.length} 条</small></a>
  </nav>

  {featuredArticle && <section class="home-feature" aria-labelledby="featured-title">
    <header class="section-heading"><p>精选文章</p><a href="/articles/">全部文章 <span aria-hidden="true">↗</span></a></header>
    <a class="featured-row" href={entryPath(featuredArticle)}>
      <div><span class="featured-row__topic">{featuredArticle.data.topic}</span><h2 id="featured-title">{featuredArticle.data.title}</h2><p>{featuredArticle.data.description}</p></div>
      <time datetime={featuredArticle.data.pubDate.toISOString()}>{formatFullDate(featuredArticle.data.pubDate, lang)}</time>
      <span class="row-arrow" aria-hidden="true">↗</span>
    </a>
    <div class="recent-articles">
      {latestArticles.filter((item) => item.id !== featuredArticle.id).map((article) => <a href={entryPath(article)}><span>{article.data.topic}</span><strong>{article.data.title}</strong><time datetime={article.data.pubDate.toISOString()}>{formatFullDate(article.data.pubDate, lang)}</time><span class="row-arrow" aria-hidden="true">↗</span></a>)}
    </div>
  </section>}

  {topics.length > 0 && <section class="home-topics" aria-labelledby="topics-title">
    <header class="section-heading"><div><p>资料库</p><h2 id="topics-title">按主题浏览</h2></div><a href="/resources/">查看全部 <span aria-hidden="true">↗</span></a></header>
    <div class="topic-links">{topics.map((topic) => <a href={`/resources/?topic=${encodeURIComponent(topic)}`}><span>{topic}</span><span aria-hidden="true">↗</span></a>)}</div>
  </section>}

  {latestThoughts.length > 0 && <section class="home-notes" aria-labelledby="notes-title">
    <header class="section-heading"><div><p>近期更新</p><h2 id="notes-title">短想法</h2></div><a href="/articles/#quick-notes">查看全部 <span aria-hidden="true">↗</span></a></header>
    <div class="simple-list">{latestThoughts.map((item) => <a href={entryPath(item)}><time datetime={item.data.pubDate.toISOString()}>{formatFullDate(item.data.pubDate, lang)}</time><strong>{item.data.title}</strong><span>{item.data.topic}</span><span class="row-arrow" aria-hidden="true">↗</span></a>)}</div>
  </section>}

  {latestJourney.length > 0 && <section class="home-journey" aria-labelledby="journey-title">
    <header class="section-heading"><div><p>个人记录</p><h2 id="journey-title">旅程片段</h2></div><a href="/journey/">查看旅程 <span aria-hidden="true">↗</span></a></header>
    <div class="simple-list">{latestJourney.map((item) => <a href={entryPath(item)}><time>{item.data.dateLabel}</time><strong>{item.data.title}</strong><span>{item.data.kind}</span><span class="row-arrow" aria-hidden="true">↗</span></a>)}</div>
  </section>}

  <section class="home-about"><p>ABOUT</p><div><h2>关于 yoyo</h2><p>更多关于我的介绍与关注方向。</p></div><a href="/about/" aria-label="阅读关于 yoyo">↗</a></section>
</main>

<style>
  .home { padding-bottom: var(--space-9); }
  .home-intro { padding-block: clamp(5rem, 13vw, 10rem) clamp(3rem, 7vw, 5.5rem); }
  .eyebrow, .section-heading > p, .section-heading > div > p, .home-about > p { margin: 0; color: var(--color-accent); font-size: var(--text-small); font-weight: 650; letter-spacing: .09em; text-transform: uppercase; }
  h1 { max-width: 17ch; margin: 1.4rem 0 0; font-size: clamp(2.7rem, 7.5vw, 5.9rem); font-weight: 650; letter-spacing: -.065em; line-height: 1.08; }
  h1 span { color: var(--color-ink-secondary); }
  .home-intro__bottom { display: flex; align-items: center; justify-content: space-between; gap: 2rem; margin-top: 2rem; }
  .home-intro__bottom p { max-width: 35rem; margin: 0; color: var(--color-ink-secondary); font-size: 1.05rem; line-height: 1.8; }
  .primary-link { display: inline-flex; flex: 0 0 auto; align-items: center; gap: 1.4rem; padding: .85rem 1.1rem; border-radius: var(--radius-sm); background: var(--color-accent); color: white; font-weight: 600; text-decoration: none; }
  .primary-link:hover { filter: brightness(.92); }
  .home-sections { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  .home-sections a { display: grid; grid-template-columns: 1fr auto; gap: .55rem; padding: 1.25rem 1rem; color: var(--color-ink); text-decoration: none; }
  .home-sections a + a { border-left: 1px solid var(--color-border); }
  .home-sections a:hover { background: var(--color-surface); }
  .home-sections span { grid-column: 1 / -1; color: var(--color-ink-tertiary); font-size: .75rem; }
  .home-sections strong { font-size: 1.05rem; }
  .home-sections small { align-self: end; color: var(--color-ink-tertiary); }
  .home-feature, .home-topics, .home-notes, .home-journey { padding-top: clamp(4rem, 9vw, 7rem); }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 1.5rem; margin-bottom: 1.2rem; }
  .section-heading h2 { margin: .35rem 0 0; font-size: clamp(1.6rem, 3vw, 2.25rem); letter-spacing: -.04em; }
  .section-heading > a { flex: 0 0 auto; color: var(--color-ink-secondary); font-size: var(--text-small); text-decoration: none; }
  .section-heading > a:hover { color: var(--color-accent); }
  .featured-row { display: grid; grid-template-columns: minmax(0, 1fr) 8rem 1.5rem; align-items: center; gap: 1.5rem; padding: 1.7rem 0; border-top: 1px solid var(--color-border-strong); border-bottom: 1px solid var(--color-border); color: var(--color-ink); text-decoration: none; }
  .featured-row:hover h2, .recent-articles a:hover strong, .simple-list a:hover strong { color: var(--color-accent); }
  .featured-row__topic { color: var(--color-accent); font-size: var(--text-small); }
  .featured-row h2 { margin: .5rem 0; font-size: clamp(1.5rem, 3vw, 2.2rem); letter-spacing: -.045em; transition: color var(--duration-fast); }
  .featured-row p { max-width: 48rem; margin: 0; color: var(--color-ink-secondary); line-height: 1.7; }
  time { color: var(--color-ink-tertiary); font-size: var(--text-small); }
  .row-arrow { color: var(--color-ink-tertiary); text-align: right; }
  .recent-articles a, .simple-list a { display: grid; grid-template-columns: minmax(6rem, .25fr) minmax(0, 1fr) minmax(6rem, .25fr) 1.5rem; align-items: center; gap: 1rem; min-height: 4.2rem; border-bottom: 1px solid var(--color-border); color: var(--color-ink); text-decoration: none; }
  .recent-articles a > span:first-child, .simple-list a > span:not(.row-arrow) { color: var(--color-ink-tertiary); font-size: var(--text-small); }
  .recent-articles strong, .simple-list strong { font-weight: 550; transition: color var(--duration-fast); }
  .topic-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--color-border); }
  .topic-links a { display: flex; justify-content: space-between; gap: 1rem; padding: 1.1rem .2rem; border-bottom: 1px solid var(--color-border); color: var(--color-ink); text-decoration: none; }
  .topic-links a:nth-child(odd) { margin-right: 1.5rem; }
  .topic-links a:nth-child(even) { margin-left: 1.5rem; }
  .topic-links a:hover { color: var(--color-accent); }
  .home-about { display: grid; grid-template-columns: 1fr 2fr 2rem; align-items: center; gap: 1.5rem; margin-top: clamp(4rem, 9vw, 7rem); padding: 1.5rem 0; border-top: 1px solid var(--color-border-strong); border-bottom: 1px solid var(--color-border); }
  .home-about h2 { margin: 0; font-size: 1.3rem; }
  .home-about div p { margin: .3rem 0 0; color: var(--color-ink-secondary); font-size: var(--text-small); }
  .home-about > a { color: var(--color-accent); font-size: 1.4rem; text-align: right; text-decoration: none; }
  @media (max-width: 640px) {
    .home-intro__bottom { align-items: flex-start; flex-direction: column; }
    .home-sections { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .home-sections a:nth-child(3) { border-left: 0; }
    .home-sections a:nth-child(n + 3) { border-top: 1px solid var(--color-border); }
    .featured-row { grid-template-columns: minmax(0, 1fr) 1.2rem; gap: .75rem; }
    .featured-row time { grid-column: 1; grid-row: 2; }
    .featured-row .row-arrow { grid-column: 2; grid-row: 1 / 3; }
    .recent-articles a, .simple-list a { grid-template-columns: minmax(0, 1fr) 1.2rem; gap: .35rem .75rem; padding-block: .8rem; }
    .recent-articles a > span:first-child, .simple-list a time { grid-column: 1; }
    .recent-articles strong, .simple-list strong { grid-column: 1; grid-row: 2; }
    .recent-articles time, .simple-list a > span:not(.row-arrow) { grid-column: 1; grid-row: 3; }
    .recent-articles .row-arrow, .simple-list .row-arrow { grid-column: 2; grid-row: 1 / 4; }
    .topic-links { grid-template-columns: 1fr; }
    .topic-links a:nth-child(n) { margin-inline: 0; }
    .home-about { grid-template-columns: 1fr auto; }
    .home-about > p { grid-column: 1 / -1; }
    .home-about > a { grid-column: 2; grid-row: 2; }
  }
</style>
