---
import { Icon } from "astro-icon/components";
import Button from "@components/ui/Button.astro";
import Chip from "@components/ui/Chip.astro";
import Section from "@components/ui/Section.astro";
import { entryPath, getArticleEntrySort, getPublicEntries } from "@utils/content-utils";
import { formatFullDate } from "@utils/time";

const lang = Astro.currentLocale || "zh-cn";
const articles = await getArticleEntrySort(lang);
const resources = (await getPublicEntries("resources"))
  .sort((a, b) => b.data.lastReviewedAt.valueOf() - a.data.lastReviewedAt.valueOf());
const thoughts = (await getPublicEntries("thoughts"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const journey = (await getPublicEntries("journey"))
  .sort((a, b) => a.data.order - b.data.order);

const featuredArticle = articles.find((article) => article.data.featured) || articles[0];
const latestArticles = articles.slice(0, 3);
const featuredResources = resources.slice(0, 3);
const featuredThoughts = thoughts.slice(0, 3);
const journeyPreview = [journey[0], journey[1], journey.at(-1)].filter(Boolean);
const publicCount = articles.length + resources.length + thoughts.length + journey.length;

const resourceTypeLabels: Record<string, string> = {
  book: "书籍",
  course: "课程",
  paper: "论文",
  documentation: "文档",
  tool: "工具",
  video: "视频",
  website: "网站",
};
---

<div class="home-page">
  <section class="opening stage-shell" aria-labelledby="opening-title">
    <div class="opening__copy">
      <p class="opening__eyebrow">Miles · Personal Digital Garden</p>
      <h1 id="opening-title">持续学习，<br /><span>也持续留下些什么。</span></h1>
      <p class="opening__lead">从电子设计、AI 到语言学习，记录正在发生的成长，也把散落的资料整理成以后仍然找得到的知识。</p>
      <div class="opening__actions">
        <Button href="/articles/" size="large">开始阅读 <Icon name="fa6-solid:arrow-right" class="w-4 h-4" /></Button>
        <Button href="#now" variant="secondary" size="large">此刻在做什么</Button>
      </div>
    </div>

    <div class="opening__visual" aria-hidden="true">
      <div class="orbit orbit--outer"></div>
      <div class="orbit orbit--middle"></div>
      <div class="orbit orbit--inner"></div>
      <div class="signal signal--one"></div>
      <div class="signal signal--two"></div>
      <div class="opening__mark">
        <img src="/brand/miles-mark.svg" width="112" height="112" alt="" loading="eager" fetchpriority="high" />
      </div>
      <p>LEARN · BUILD · REFLECT</p>
    </div>

    <dl class="opening__metrics" aria-label="站点概况">
      <div><dt>{publicCount}</dt><dd>条公开记录</dd></div>
      <div><dt>5</dt><dd>个长期方向</dd></div>
      <div><dt>2026</dt><dd>数字花园启程</dd></div>
    </dl>
  </section>

  <Section id="now" eyebrow="Now" title="现在，正在把学习变成可复用的记录。" description="不追求同时铺开所有主题。先完成真实项目中的学习闭环，再把验证过的方法、失败和结论写下来。" tone="raised" class="home-now">
    <div class="now-grid">
      <article data-aos="fade-up">
        <span class="now-card__index">01</span>
        <Icon name="fa6-solid:microchip" class="now-card__icon" />
        <h3>电子设计与工程实践</h3>
        <p>保留比赛与项目的事实节点；技术细节和个人贡献只在完成授权与复盘后公开。</p>
      </article>
      <article data-aos="fade-up" data-aos-delay="60">
        <span class="now-card__index">02</span>
        <Icon name="fa6-solid:code" class="now-card__icon" />
        <h3>AI 与工程工具</h3>
        <p>从 PyTorch、Python 环境和 Git 工作流开始，用最小实验替代只收藏不验证。</p>
      </article>
      <article data-aos="fade-up" data-aos-delay="120">
        <span class="now-card__index">03</span>
        <Icon name="fa6-solid:language" class="now-card__icon" />
        <h3>语言与长期知识整理</h3>
        <p>把课堂材料留在私域，公开站只保留自己的方法、进度、错误类型与阶段复盘。</p>
      </article>
    </div>
  </Section>

  {featuredArticle && (
    <Section id="featured" eyebrow="Featured story" title="一个网站，应该记得它为什么开始。" description="首批文章从建站过程本身出发：为什么记录、怎样组织，以及哪些内容应当永远留在私域。">
      <a class="featured-story" href={entryPath(featuredArticle)} data-aos="fade-up">
        <div class="featured-story__visual" aria-hidden="true">
          <span class="featured-story__halo"></span>
          <span class="featured-story__line">01</span>
          <strong>MILES<br />ARCHIVE</strong>
        </div>
        <div class="featured-story__copy">
          <div class="featured-story__meta">
            <Chip tone="accent">{featuredArticle.data.topic}</Chip>
            <span>{formatFullDate(featuredArticle.data.pubDate, lang)}</span>
          </div>
          <h3>{featuredArticle.data.title}</h3>
          <p>{featuredArticle.data.description}</p>
          <span class="featured-story__link">阅读全文 <Icon name="fa6-solid:arrow-right" class="w-4 h-4" /></span>
        </div>
      </a>
    </Section>
  )}

  <Section id="resources" eyebrow="Learning library" title="把链接变成学习路径。" description="资料库不是文件堆积：每条内容说明为什么保留、怎样使用、当前进度和最近复核时间。" tone="dark">
    <div class="resource-grid">
      {featuredResources.map((resource, index) => (
        <a href={entryPath(resource)} class="resource-card" data-aos="fade-up" data-aos-delay={String(index * 60)}>
          <div class="resource-card__top">
            <span>{resourceTypeLabels[resource.data.resourceType] || resource.data.resourceType}</span>
            <span>{String(index + 1).padStart(2, "0")}</span>
          </div>
          <h3>{resource.data.title}</h3>
          <p>{resource.data.description}</p>
          <div class="resource-card__progress" aria-label={`学习进度 ${resource.data.progress}%`}>
            <span style={`width: ${resource.data.progress}%`}></span>
          </div>
          <div class="resource-card__bottom">
            <span>{resource.data.topic}</span>
            <span>{resource.data.progress}%</span>
          </div>
        </a>
      ))}
    </div>
    <div class="section-link"><Button href="/resources/" variant="secondary">查看全部资料</Button></div>
  </Section>

  <Section id="thoughts" eyebrow="Thoughts" title="短一点，也可以足够清楚。" description="一个观察、一条判断，或者一次值得保存的修正。">
    <div class="thought-list">
      {featuredThoughts.map((thought, index) => (
        <a href={entryPath(thought)} class="thought-row" data-aos="fade-up" data-aos-delay={String(index * 45)}>
          <time datetime={thought.data.pubDate.toISOString()}>{formatFullDate(thought.data.pubDate, lang)}</time>
          <div>
            <h3>{thought.data.title}</h3>
            <p>{thought.data.description}</p>
          </div>
          <Icon name="fa6-solid:arrow-right" class="thought-row__icon" />
        </a>
      ))}
    </div>
    <div class="section-link"><Button href="/thoughts/" variant="quiet">浏览全部短想法 <Icon name="fa6-solid:arrow-right" class="w-4 h-4" /></Button></div>
  </Section>

  <Section id="journey" eyebrow="Journey" title="成长不是一条直线，但值得留下坐标。" description="这里只记录本人同意公开的年份、学校和经过核验的成果摘要。">
    <ol class="journey-line">
      {journeyPreview.map((item, index) => item && (
        <li data-aos="fade-up" data-aos-delay={String(index * 60)}>
          <a href={entryPath(item)}>
            <time>{item.data.dateLabel}</time>
            <span class="journey-line__dot" aria-hidden="true"></span>
            <div>
              <h3>{item.data.title}</h3>
              <p>{item.data.summary}</p>
            </div>
          </a>
        </li>
      ))}
    </ol>
    <div class="section-link"><Button href="/journey/" variant="secondary">查看完整旅程</Button></div>
  </Section>

  <Section id="latest" eyebrow="Latest" title="最新文章" description="系统整理，也保留时间留下的脉络。" tone="raised">
    <div class="latest-grid">
      {latestArticles.map((article, index) => (
        <a href={entryPath(article)} class="latest-card" data-aos="fade-up" data-aos-delay={String(index * 55)}>
          <span class="latest-card__number">{String(index + 1).padStart(2, "0")}</span>
          <div>
            <span class="latest-card__topic">{article.data.topic}</span>
            <h3>{article.data.title}</h3>
            <p>{article.data.description}</p>
            <time datetime={article.data.pubDate.toISOString()}>{formatFullDate(article.data.pubDate, lang)}</time>
          </div>
        </a>
      ))}
    </div>
    <div class="section-link"><Button href="/articles/">全部文章 <Icon name="fa6-solid:arrow-right" class="w-4 h-4" /></Button></div>
  </Section>

  <section class="closing stage-shell" aria-labelledby="closing-title">
    <p>Miles · Since 2026</p>
    <h2 id="closing-title">慢慢积累，<br />保持清醒。</h2>
    <div>
      <Button href="/about/" size="large">关于我</Button>
      <Button href="/rss.xml" variant="quiet" size="large">订阅 RSS</Button>
    </div>
  </section>
</div>

<style>
  .home-page { overflow: clip; }

  .opening {
    position: relative;
    display: grid;
    min-height: calc(100svh - var(--header-height));
    grid-template-columns: minmax(0, 1.08fr) minmax(21rem, 0.92fr);
    align-content: center;
    column-gap: clamp(2rem, 7vw, 7rem);
    padding-block: clamp(5rem, 10vw, 8rem) var(--space-8);
  }

  .opening__copy { position: relative; z-index: 2; align-self: center; }
  .opening__eyebrow {
    margin: 0 0 var(--space-5);
    color: var(--color-accent);
    font-size: var(--text-small);
    font-weight: 720;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .opening h1 {
    max-width: 11ch;
    margin: 0;
    font-size: clamp(3.35rem, 7vw, 6.7rem);
    font-weight: 760;
    letter-spacing: -0.062em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .opening h1 span {
    display: block;
    font-size: 0.76em;
    white-space: nowrap;
    color: transparent;
    background: linear-gradient(115deg, var(--color-accent), #6f8cff 48%, #b46cff 95%);
    background-clip: text;
    -webkit-background-clip: text;
  }

  .opening__lead {
    max-width: 38rem;
    margin: var(--space-6) 0 0;
    color: var(--color-ink-secondary);
    font-size: clamp(1.08rem, 1.65vw, 1.35rem);
    line-height: 1.65;
  }

  .opening__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-7); }

  .opening__visual {
    position: relative;
    display: grid;
    aspect-ratio: 1;
    width: min(100%, 31rem);
    place-items: center;
    align-self: center;
    justify-self: end;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 45%, color-mix(in srgb, var(--color-accent) 21%, transparent), transparent 35%),
      color-mix(in srgb, var(--color-surface-solid) 72%, transparent);
    box-shadow: var(--shadow-lg);
    isolation: isolate;
  }

  .opening__visual::before {
    position: absolute;
    inset: 12%;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-accent) 20%, transparent), transparent 65%);
    content: "";
    filter: blur(16px);
  }

  .opening__visual p {
    position: absolute;
    bottom: 11%;
    margin: 0;
    color: var(--color-ink-tertiary);
    font-size: 0.67rem;
    font-weight: 700;
    letter-spacing: 0.2em;
  }

  .opening__mark {
    position: relative;
    z-index: 2;
    display: grid;
    width: 9.5rem;
    aspect-ratio: 1;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--color-accent) 28%, var(--color-border));
    border-radius: 2.5rem;
    background: color-mix(in srgb, var(--color-surface-solid) 76%, transparent);
    box-shadow: 0 30px 80px color-mix(in srgb, var(--color-accent) 20%, transparent);
    transform: rotate(-5deg);
  }

  .opening__mark img { width: 7rem; height: 7rem; border-radius: 1.6rem; }
  .orbit { position: absolute; border: 1px solid color-mix(in srgb, var(--color-ink) 12%, transparent); border-radius: 50%; }
  .orbit--outer { inset: 7%; }
  .orbit--middle { inset: 21%; }
  .orbit--inner { inset: 34%; }
  .signal { position: absolute; z-index: 3; width: 0.7rem; aspect-ratio: 1; border-radius: 50%; background: var(--color-accent); box-shadow: 0 0 0 0.45rem color-mix(in srgb, var(--color-accent) 14%, transparent); }
  .signal--one { top: 20%; right: 21%; }
  .signal--two { bottom: 25%; left: 15%; width: 0.46rem; background: #a855f7; }

  .opening__metrics {
    display: flex;
    grid-column: 1 / -1;
    gap: clamp(2rem, 7vw, 6rem);
    align-self: end;
    margin: clamp(4rem, 9vh, 7rem) 0 0;
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .opening__metrics div { display: grid; gap: 0.1rem; }
  .opening__metrics dt { color: var(--color-ink); font-size: 1.25rem; font-weight: 720; }
  .opening__metrics dd { margin: 0; color: var(--color-ink-tertiary); font-size: var(--text-small); }

  .now-grid, .resource-grid, .latest-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5); }
  .now-grid article {
    position: relative;
    min-height: 21rem;
    padding: var(--space-6);
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface-solid);
    box-shadow: var(--shadow-sm);
  }
  .now-grid article::after { position: absolute; right: -18%; bottom: -28%; width: 12rem; aspect-ratio: 1; border-radius: 50%; background: color-mix(in srgb, var(--color-accent) 8%, transparent); content: ""; }
  .now-card__index { color: var(--color-ink-tertiary); font: 600 0.72rem/1 var(--font-mono); }
  :global(.now-card__icon) { display: block; width: 2rem; height: 2rem; margin: var(--space-8) 0 var(--space-5); color: var(--color-accent); }
  .now-grid h3, .resource-card h3, .latest-card h3, .thought-row h3, .journey-line h3 { margin: 0; font-size: var(--text-title); line-height: 1.18; letter-spacing: -0.035em; }
  .now-grid p { position: relative; z-index: 1; margin: var(--space-4) 0 0; color: var(--color-ink-secondary); }

  .featured-story {
    display: grid;
    min-height: 35rem;
    grid-template-columns: 1.08fr 0.92fr;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface-solid);
    box-shadow: var(--shadow-md);
    color: var(--color-ink);
    text-decoration: none;
  }
  .featured-story__visual {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 31rem;
    padding: var(--space-7);
    overflow: hidden;
    background:
      radial-gradient(circle at 78% 24%, rgb(88 106 255 / 0.6), transparent 23%),
      radial-gradient(circle at 18% 82%, rgb(0 113 227 / 0.6), transparent 27%),
      linear-gradient(140deg, #08090d 0%, #11162b 48%, #050505 100%);
    color: #f5f5f7;
  }
  .featured-story__visual::before, .featured-story__visual::after { position: absolute; border: 1px solid rgb(255 255 255 / 0.15); border-radius: 50%; content: ""; }
  .featured-story__visual::before { width: 34rem; aspect-ratio: 1; top: -20%; right: -26%; }
  .featured-story__visual::after { width: 20rem; aspect-ratio: 1; right: -5%; bottom: -20%; }
  .featured-story__visual strong { position: relative; z-index: 1; font-size: clamp(3.5rem, 7vw, 6.5rem); letter-spacing: -0.07em; line-height: 0.78; }
  .featured-story__line { position: absolute; top: var(--space-6); left: var(--space-7); font: 600 0.8rem/1 var(--font-mono); letter-spacing: 0.15em; }
  .featured-story__halo { position: absolute; top: 22%; left: 46%; width: 9rem; aspect-ratio: 1; border-radius: 50%; background: rgb(64 156 255 / 0.62); filter: blur(3rem); }
  .featured-story__copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(2rem, 5vw, 4.25rem); }
  .featured-story__meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); color: var(--color-ink-tertiary); font-size: var(--text-small); }
  .featured-story__copy h3 { margin: var(--space-6) 0 0; font-size: clamp(2.25rem, 4vw, 4rem); line-height: 1.03; letter-spacing: -0.055em; }
  .featured-story__copy p { margin: var(--space-5) 0 0; color: var(--color-ink-secondary); font-size: 1.08rem; }
  .featured-story__link { display: inline-flex; align-items: center; gap: var(--space-2); margin-top: var(--space-7); color: var(--color-accent); font-weight: 650; }

  .resource-card {
    display: flex;
    min-height: 25rem;
    flex-direction: column;
    padding: var(--space-6);
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: var(--radius-lg);
    background: linear-gradient(145deg, rgb(255 255 255 / 0.09), rgb(255 255 255 / 0.035));
    color: #f5f5f7;
    text-decoration: none;
    transition: transform var(--duration-normal) var(--ease-standard), border-color var(--duration-normal);
  }
  .resource-card:hover { transform: translateY(-4px); border-color: rgb(255 255 255 / 0.32); }
  .resource-card__top, .resource-card__bottom { display: flex; justify-content: space-between; color: #86868b; font: 600 0.75rem/1 var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; }
  .resource-card h3 { margin-top: var(--space-9); color: #f5f5f7; }
  .resource-card p { margin: var(--space-4) 0 var(--space-7); color: #a1a1a6; }
  .resource-card__progress { height: 0.22rem; margin-top: auto; overflow: hidden; border-radius: var(--radius-pill); background: rgb(255 255 255 / 0.13); }
  .resource-card__progress span { display: block; height: 100%; border-radius: inherit; background: #2997ff; }
  .resource-card__bottom { margin-top: var(--space-3); }

  .thought-list { border-top: 1px solid var(--color-border); }
  .thought-row { display: grid; grid-template-columns: 9rem minmax(0, 1fr) auto; gap: var(--space-6); align-items: start; padding-block: var(--space-6); border-bottom: 1px solid var(--color-border); color: var(--color-ink); text-decoration: none; }
  .thought-row time { color: var(--color-ink-tertiary); font-size: var(--text-small); }
  .thought-row p { max-width: 44rem; margin: var(--space-2) 0 0; color: var(--color-ink-secondary); }
  :global(.thought-row__icon) { width: 1rem; height: 1rem; margin-top: 0.35rem; color: var(--color-ink-tertiary); transition: transform var(--duration-fast), color var(--duration-fast); }
  .thought-row:hover :global(.thought-row__icon) { color: var(--color-accent); transform: translateX(0.25rem); }

  .journey-line { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; }
  .journey-line li { position: relative; }
  .journey-line li:not(:last-child)::after { position: absolute; top: 2.25rem; bottom: -2.25rem; left: calc(9rem + 0.3rem); width: 1px; background: var(--color-border); content: ""; }
  .journey-line a { display: grid; grid-template-columns: 8rem 1.1rem minmax(0, 1fr); gap: var(--space-5); padding-block: var(--space-6); color: var(--color-ink); text-decoration: none; }
  .journey-line time { color: var(--color-accent); font-weight: 700; }
  .journey-line__dot { position: relative; z-index: 1; width: 0.75rem; height: 0.75rem; margin-top: 0.55rem; border: 3px solid var(--color-canvas); border-radius: 50%; background: var(--color-accent); box-shadow: 0 0 0 1px var(--color-accent); }
  .journey-line p { margin: var(--space-2) 0 0; color: var(--color-ink-secondary); }

  .latest-card { display: grid; min-height: 24rem; grid-template-rows: auto 1fr; padding: var(--space-6); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface-solid); color: var(--color-ink); text-decoration: none; transition: transform var(--duration-normal), box-shadow var(--duration-normal); }
  .latest-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .latest-card__number { color: var(--color-ink-tertiary); font: 600 0.75rem/1 var(--font-mono); }
  .latest-card > div { align-self: end; }
  .latest-card__topic { color: var(--color-accent); font-size: var(--text-small); font-weight: 700; }
  .latest-card h3 { margin-top: var(--space-3); }
  .latest-card p { margin: var(--space-4) 0 var(--space-5); color: var(--color-ink-secondary); }
  .latest-card time { color: var(--color-ink-tertiary); font-size: var(--text-small); }

  .section-link { display: flex; justify-content: center; margin-top: var(--space-7); }
  .closing { padding-block: clamp(7rem, 16vw, 13rem); text-align: center; }
  .closing > p { margin: 0 0 var(--space-5); color: var(--color-accent); font-size: var(--text-small); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .closing h2 { margin: 0; font-size: clamp(3.4rem, 9vw, 7.5rem); letter-spacing: -0.065em; line-height: 0.94; }
  .closing > div { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3); margin-top: var(--space-7); }

  @media (max-width: 900px) {
    .opening { grid-template-columns: 1fr; min-height: auto; }
    .opening__copy { max-width: 48rem; }
    .opening__visual { width: min(78vw, 30rem); margin-top: var(--space-9); justify-self: center; }
    .now-grid, .resource-grid { grid-template-columns: 1fr; }
    .now-grid article { min-height: auto; }
    :global(.now-card__icon) { margin-top: var(--space-7); }
    .featured-story { grid-template-columns: 1fr; }
    .featured-story__visual { min-height: 26rem; }
    .latest-grid { grid-template-columns: 1fr; }
    .latest-card { min-height: 18rem; }
