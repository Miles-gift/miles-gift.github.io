---
import data from '../data/friend-links.json';

const links = data.links.filter((link) => link.enabled);
const initial = (name: string) => Array.from(name.trim())[0]?.toLocaleUpperCase() || '友';
const hostname = (url: string) => {
	try { return new URL(url).hostname.replace(/^www\./, ''); } catch { return url; }
};
---

{links.length > 0 && (
	<section class="friend-links" aria-labelledby="friend-links-title">
		<h2 id="friend-links-title">友联</h2>
		<ul class="friend-links-list">
			{links.map((link) => (
				<li>
					<a class="friend-link" href={link.url} target="_blank" rel="noopener noreferrer" aria-label={`${link.name}，新窗口打开`}>
						<span class="friend-link-initial" aria-hidden="true">{initial(link.name)}</span>
						<span class="friend-link-copy">
							<strong>{link.name}</strong>
							{link.description && <span class="friend-link-description">{link.description}</span>}
							{hostname(link.url).toLocaleLowerCase() !== link.name.toLocaleLowerCase() && <span class="friend-link-domain">{hostname(link.url)}</span>}
						</span>
					</a>
				</li>
			))}
		</ul>
	</section>
)}

<style>
	.friend-links {
		margin-top: 2.25rem;
	}

	.friend-links h2 {
		margin: 0 0 1rem;
		color: var(--color-text-strong);
		font-size: clamp(1.35rem, 2vw, 1.6rem);
		font-weight: 600;
		line-height: 1.3;
	}

	.friend-links-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		margin: 0;
		padding: 0;
		list-style: none;
		border: 1px solid var(--color-border);
		border-radius: 18px;
		background: var(--color-surface);
		box-shadow: var(--shadow-card);
		overflow: hidden;
	}

	.friend-links-list li + li {
		border-left: 1px solid var(--color-border-subtle);
	}

	.friend-link {
		display: flex;
		min-height: 108px;
		align-items: center;
		gap: 1rem;
		padding: 1.25rem;
		color: inherit;
		text-decoration: none;
		transition: background-color 180ms ease, color 180ms ease;
	}

	.friend-link:hover {
		background: var(--color-surface-hover);
	}

	.friend-link:focus-visible {
		position: relative;
		z-index: 1;
		outline: 3px solid var(--accent);
		outline-offset: -4px;
	}

	.friend-link-initial {
		display: grid;
		width: 46px;
		height: 46px;
		flex: 0 0 46px;
		place-items: center;
		border: 1px solid color-mix(in srgb, var(--accent) 22%, var(--color-border));
		border-radius: 50%;
		background: color-mix(in srgb, var(--accent) 8%, var(--color-surface));
		color: var(--accent);
		font-size: 1.15rem;
		font-weight: 600;
	}

	.friend-link-copy {
		display: grid;
		min-width: 0;
		gap: 0.2rem;
		overflow-wrap: anywhere;
	}

	.friend-link-copy strong {
		color: var(--color-text-strong);
		font-size: 1.05rem;
		font-weight: 600;
		line-height: 1.4;
	}

	.friend-link-description {
		color: var(--color-text-secondary);
		font-size: 0.9rem;
		line-height: 1.55;
	}

	.friend-link-domain {
		color: var(--color-text-secondary);
		font-size: 0.82rem;
		line-height: 1.45;
	}

	@media (max-width: 720px) {
		.friend-links-list {
			grid-template-columns: 1fr;
			border-radius: 0;
		}

		.friend-links-list li + li {
			border-top: 1px solid var(--color-border-subtle);
			border-left: 0;
		}

		.friend-link {
			min-height: 96px;
			padding: 1rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.friend-link { transition: none; }
	}
</style>
