---
import data from '../data/friend-links.json';

const links = data.links.filter((link) => link.enabled);
const initial = (name: string) => Array.from(name.trim())[0]?.toLocaleUpperCase() || '友';
const hostname = (url: string) => {
	try { return new URL(url).hostname.replace(/^www\./, ''); } catch { return url; }
};
---

{links.length > 0 && (
	<section class="friend-links" aria-labelledby="friend-links-title">
		<h2 id="friend-links-title">友联</h2>
		<ul class="friend-links-list">
			{links.map((link, index) => (
				<li style={`--friend-index: ${index}`}>
					<a class="friend-link" href={link.url} target="_blank" rel="noopener noreferrer" aria-label={`${link.name}，新窗口打开`}>
						{link.avatar ? (
							<img class:list={['friend-link-avatar', link.id === 'zgzlcc' && 'friend-link-avatar-wide']} src={link.avatar} alt="" width={link.id === 'zgzlcc' ? '94' : '58'} height="58" loading="lazy" decoding="async" />
						) : (
							<span class="friend-link-avatar friend-link-initial" aria-hidden="true">{initial(link.name)}</span>
						)}
						<span class="friend-link-copy">
							<strong>{link.name}</strong>
							{link.description && <span class="friend-link-description">{link.description}</span>}
							{hostname(link.url).toLocaleLowerCase() !== link.name.toLocaleLowerCase() && <span class="friend-link-domain">{hostname(link.url)}</span>}
						</span>
					</a>
				</li>
			))}
		</ul>
	</section>
)}

<style>
	.friend-links {
		margin-top: 2.25rem;
	}

	.friend-links h2 {
		margin: 0 0 1rem;
		color: var(--color-text-strong);
		font-size: clamp(1.35rem, 2vw, 1.6rem);
		font-weight: 600;
		line-height: 1.3;
	}

	.friend-links-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.friend-links-list li {
		min-width: 0;
		border: 1px solid var(--color-border);
		border-radius: 18px;
		background: var(--color-surface);
		box-shadow: var(--shadow-card);
		animation: friend-link-enter 520ms cubic-bezier(.2, .75, .25, 1) both;
		animation-delay: calc(min(var(--friend-index), 5) * 70ms);
		transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
	}

	.friend-links-list li:hover,
	.friend-links-list li:focus-within {
		transform: translateY(-4px);
		border-color: color-mix(in srgb, var(--accent) 30%, var(--color-border));
		box-shadow: 0 12px 30px color-mix(in srgb, var(--color-text-strong) 10%, transparent);
	}

	.friend-link {
		display: flex;
		min-height: 112px;
		align-items: center;
		gap: 1rem;
		padding: 1.25rem;
		border-radius: inherit;
		color: inherit;
		text-decoration: none;
	}

	.friend-link:focus-visible {
		outline: 3px solid var(--accent);
		outline-offset: -4px;
	}

	.friend-link-avatar {
		display: block;
		width: 58px;
		height: 58px;
		flex: 0 0 58px;
		border: 1px solid color-mix(in srgb, var(--color-border) 75%, transparent);
		border-radius: 50%;
		object-fit: cover;
		background: var(--color-surface-hover);
		transition: transform 240ms cubic-bezier(.2, .75, .25, 1), box-shadow 240ms ease;
	}

	.friend-link:hover .friend-link-avatar,
	.friend-link:focus-visible .friend-link-avatar {
		transform: scale(1.08);
		box-shadow: 0 4px 12px color-mix(in srgb, var(--color-text-strong) 14%, transparent);
	}

	.friend-link-initial {
		display: grid;
		place-items: center;
		border-color: color-mix(in srgb, var(--accent) 22%, var(--color-border));
		background: color-mix(in srgb, var(--accent) 8%, var(--color-surface));
		color: var(--accent);
		font-size: 1.15rem;
		font-weight: 600;
	}

	.friend-link-avatar-wide {
		width: 94px;
		flex-basis: 94px;
		border-radius: 15px;
	}

	.friend-link-copy {
		display: grid;
		min-width: 0;
		gap: 0.2rem;
		overflow-wrap: anywhere;
	}

	.friend-link-copy strong {
		color: var(--color-text-strong);
		font-size: 1.05rem;
		font-weight: 600;
		line-height: 1.4;
	}

	.friend-link-description {
		color: var(--color-text-secondary);
		font-size: 0.9rem;
		line-height: 1.55;
	}

	.friend-link-domain {
		color: var(--color-text-secondary);
		font-size: 0.82rem;
		line-height: 1.45;
	}

	@keyframes friend-link-enter {
		from { opacity: 0; transform: translateY(10px); }
		to { opacity: 1; transform: translateY(0); }
	}

	@media (max-width: 720px) {
		.friend-links-list {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}

		.friend-link {
			min-height: 100px;
			padding: 1rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.friend-links-list li,
		.friend-link-avatar {
			animation: none;
			transition: none;
		}
		.friend-links-list li:hover,
		.friend-links-list li:focus-within,
		.friend-link:hover .friend-link-avatar,
		.friend-link:focus-visible .friend-link-avatar {
			transform: none;
		}
	}
</style>
