---
import { siteConfig, profileConfig } from '@/config';
import "@styles/global.css"
import 'katex/dist/katex.min.css';
import '@fontsource/noto-serif-sc/400.css';
import '@fontsource/noto-serif-sc/700.css';
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/600.css';
import '@fontsource/eb-garamond/600-italic.css';
import '@chinese-fonts/lxgwwenkaibright/dist/LXGWBright-Regular/result.css';
import '@chinese-fonts/lxgwwenkaibright/dist/LXGWBright-Medium/result.css';
import '@chinese-fonts/lxgwwenkaibright/dist/LXGWBright-Italic/result.css';
import { i18n } from "astro:config/client";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  lang?: string;
  description?: string;
}
const { title, lang, description } = Astro.props;

const pageTitle = title;
const pageLang = lang || i18n?.defaultLocale || "zh-cn";
---

<!DOCTYPE html>
<html lang={pageLang} class="h-full">
<head>
    <script is:inline>
        (function() {
        const savedTheme = localStorage.getItem('theme');
        const preference = ['light', 'dark', 'system'].includes(savedTheme) ? savedTheme : 'system';
        const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        const theme = preference === 'system' ? systemTheme : preference;
        localStorage.setItem('theme', preference);
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.classList.toggle('system-theme', preference === 'system');

        if (theme === 'dark') {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
        })();
    </script>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">
    <meta name="description" content={(description != null && description !== undefined && description !== "") ? description : profileConfig.description}>
    <meta name="author" content={profileConfig.name}>
    <link rel="icon" href={siteConfig.favicon} type="image/svg+xml">
    <title>{pageTitle}</title>
    <ClientRouter />
    <script is:inline>
        document.addEventListener('astro:before-swap', (e) => {
            const theme = document.documentElement.getAttribute('data-theme');
            const sysTheme = document.documentElement.classList.contains('system-theme');
            if (theme) {
                e.newDocument.documentElement.setAttribute('data-theme', theme);
            }
            if (sysTheme) {
                e.newDocument.documentElement.classList.add('system-theme');
            }
        });
    </script>
</head>
<body class="h-full bg-[var(--bg-color)]">

    <div id="loading-overlay" aria-hidden="true"><span></span></div>

    <slot />

    <script is:inline>
        let loaderTimeout;

        // 1. 开始准备跳转
        document.addEventListener('astro:before-preparation', () => {
            loaderTimeout = setTimeout(() => {
            const overlay = document.getElementById('loading-overlay');
            if (overlay) overlay.style.display = 'flex';
            }, 420);
        });

        // 2. 页面内容交换完成（DOM 已更新）
        document.addEventListener('astro:after-swap', () => {
            clearTimeout(loaderTimeout);

            const overlay = document.getElementById('loading-overlay');
            if (overlay) overlay.style.display = 'none';
        });

        // 3. 兜底方案：页面完全加载完成（包括资源）
        document.addEventListener('astro:page-load', () => {
            clearTimeout(loaderTimeout);
            const overlay = document.getElementById('loading-overlay');
            if (overlay) overlay.style.display = 'none';
        });
        </script>
</body>
</html>

<style is:global>
  #loading-overlay {
    position: fixed;
    inset: 0;
    display: none;
    align-items: flex-start;
    justify-content: flex-start;
    background-color: color-mix(in srgb, var(--color-canvas) 72%, transparent);
    z-index: var(--z-toast);
    backdrop-filter: blur(3px);
  }

  [data-theme="dark"] #loading-overlay {
    background-color: color-mix(in srgb, var(--color-canvas) 72%, transparent);
  }

  #loading-overlay span {
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, var(--color-growth), var(--color-accent), var(--color-annotation));
    transform-origin: left;
    animation: write-across 1.2s var(--ease-emphasized) infinite;
  }

  @keyframes write-across { 0% { transform: scaleX(0); } 70%, 100% { transform: scaleX(1); } }

</style>

{ siteConfig.theme.AOS &&
<script>
  import AOS from 'aos';
  import 'aos/dist/aos.css';

  function initApp() {
    // 1. 先处理 Markdown 的动态注入 (如果有)
    const container = document.querySelector('.markdown-content');
    if (container) {
      const elements = container.querySelectorAll(':scope > *');
      elements.forEach((el, i) => {
        el.setAttribute('data-aos', 'fade-up');
        el.setAttribute('data-aos-delay', (i % 5 * 50).toString());
      });
    }

    // 2. 统一初始化
    AOS.init({
      duration: 800,
      once: true,
    });

    // 3. 强力刷新
    AOS.refreshHard();
  }

  document.addEventListener('astro:page-load', initApp);
  // document.addEventListener('astro:after-swap', initApp);

</script>
}
