---
import ContentEntryLayout from "@components/content/ContentEntryLayout.astro";
import { getPublicEntries } from "@utils/content-utils";
import { render } from "astro:content";
import { i18n } from "astro:config/client";

export async function getStaticPaths() {
  return (i18n?.locales || [i18n?.defaultLocale]).map((locale) => {
    const localeCode = typeof locale === "string" ? locale : locale.path;
    return { params: { locale: localeCode === i18n?.defaultLocale ? undefined : localeCode } };
  });
}

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const page = (await getPublicEntries("pages")).find((entry) => entry.data.slug === "copyright");
if (!page) throw new Error("Missing copyright page");
const { Content } = await render(page);
---

<ContentEntryLayout pageTitle={`${page.data.title} - Miles`} title={page.data.title} description={page.data.description} eyebrow="版权说明" lang={currentLang} dateLabel={`更新于 ${page.data.updatedDate.toLocaleDateString("zh-CN")}`}>
  <Content />
</ContentEntryLayout>
