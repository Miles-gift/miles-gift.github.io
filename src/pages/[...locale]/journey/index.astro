---
import MainPageLayout from "@layouts/MainPageLayout.astro";
import CinematicHero from "@components/ui/CinematicHero.astro";
import FloatingPanel from "@components/ui/FloatingPanel.astro";
import UlboContentRow from "@components/content/UlboContentRow.astro";
import { siteConfig } from "@/config";
import { entryPath, getPublicEntries } from "@utils/content-utils";
import { i18n } from "astro:config/client";

export function getStaticPaths() { return i18n?.locales.map((locale) => ({ params: { locale: locale === i18n?.defaultLocale ? undefined : String(locale) } })); }
const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const all = await getPublicEntries("journey");
const sections = [
  { id: "education", title: "教育经历", description: "学校、专业与学习阶段。", entries: all.filter((item) => item.data.kind === "education").sort((a, b) => a.data.startDate.localeCompare(b.data.startDate)) },
  { id: "service", title: "校园服务", description: "参与班级与学生资助服务的日常。", entries: all.filter((item) => item.data.kind === "service").sort((a, b) => b.data.startDate.localeCompare(a.data.startDate)) },
  { id: "awards", title: "获奖与里程碑", description: "已经核验的成果与重要节点。", entries: all.filter((item) => item.data.kind === "award" || item.data.kind === "milestone").sort((a, b) => b.data.startDate.localeCompare(a.data.startDate)) },
];
---

<MainPageLayout title={`旅程 - ${siteConfig.title}`} description="从靖江到武汉：教育经历、校园服务、获奖与里程碑。" lang={currentLang}>
  <CinematicHero title="我的旅程" description="把已经走过的路留下坐标，也继续看向下一站。" />
  <FloatingPanel id="page-content" class="journey-panel">
    <nav class="journey-nav" aria-label="旅程分区">{sections.map((section) => <a href={`#${section.id}`}>{section.title} <span>{section.entries.length}</span></a>)}</nav>
    {sections.map((section) => <section id={section.id} class="journey-section" aria-labelledby={`${section.id}-title`}><header><h2 id={`${section.id}-title`}>{section.title}</h2><p>{section.description}</p></header><div class="journey-list">{section.entries.map((entry) => <UlboContentRow href={entryPath(entry)} title={entry.data.title} description={entry.data.summary} kind={entry.data.kind === "education" ? "教育" : entry.data.kind === "service" ? "服务" : entry.data.kind === "award" ? "获奖" : "里程碑"} topic={entry.data.organization || entry.data.location} date={entry.data.dateLabel} tags={entry.data.skills} />)}</div></section>)}
    <p class="journey-privacy">证书图片、证书编号、二维码、队友与指导教师信息均不在本站展示。</p>
  </FloatingPanel>
</MainPageLayout>

<style>
  .journey-nav { display: flex; flex-wrap: wrap; gap: .5rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--color-border); }
  .journey-nav a { padding: .45rem .8rem; border: 1px solid var(--color-border); border-radius: 999px; color: var(--color-ink-secondary); font-size: .87rem; text-decoration: none; }
  .journey-nav a:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .journey-nav span { margin-left: .3rem; color: var(--color-ink-tertiary); }
  .journey-section { padding-top: 2.25rem; scroll-margin-top: 5rem; }
  .journey-section header { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .journey-section h2 { margin: 0; font-size: 1.5rem; }
  .journey-section header p { margin: 0; color: var(--color-ink-secondary); font-size: .88rem; }
  .journey-list { border-top: 1px solid var(--color-border); }
  .journey-privacy { margin: 2.5rem 0 0; padding-top: 1rem; border-top: 1px solid var(--color-border); color: var(--color-ink-tertiary); font-size: .8rem; }
  @media (max-width: 600px) { .journey-section header { align-items: flex-start; flex-direction: column; gap: .2rem; } }
</style>
