---
import ContentEntryLayout from "@components/content/ContentEntryLayout.astro";
import { getPublicEntries } from "@utils/content-utils";
import { render } from "astro:content";
import { i18n } from "astro:config/client";
import { siteConfig } from "@/config";

export async function getStaticPaths() {
  const entries = await getPublicEntries("journey");
  return (i18n?.locales || [i18n?.defaultLocale]).flatMap((locale) => {
    const localeCode = typeof locale === "string" ? locale : locale.path;
    return entries.map((entry) => ({ params: { locale: localeCode === i18n?.defaultLocale ? undefined : localeCode, slug: entry.data.slug }, props: { entry } }));
  });
}

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const { entry } = Astro.props;
const { Content } = await render(entry);
const tags = [...entry.data.skills, entry.data.kind];
---

<ContentEntryLayout pageTitle={`${entry.data.title} - ${siteConfig.title}`} title={entry.data.title} description={entry.data.summary} eyebrow="旅程坐标" lang={currentLang} pubDate={entry.data.pubDate} dateLabel={entry.data.dateLabel} tags={tags} backHref="/journey/" backLabel="完整旅程">
  {(entry.data.organization || entry.data.highlights.length > 0) && <div class="journey-facts">
    {entry.data.organization && <p><span>机构</span><strong>{entry.data.organization}</strong></p>}
    {entry.data.highlights.map((item) => <p><span>节点</span><strong>{item}</strong></p>)}
  </div>}
  {entry.data.role && <p><strong>角色：</strong>{entry.data.role}</p>}
  {entry.data.location && <p><strong>位置：</strong>{entry.data.location}</p>}
  {entry.data.projectTitle && <p><strong>项目：</strong>{entry.data.projectTitle}</p>}
  <Content />
</ContentEntryLayout>

<style>
  .journey-facts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3); margin-bottom: var(--space-6); }
  .journey-facts p { display: grid; gap: var(--space-1); margin: 0; padding: var(--space-4); border-radius: var(--radius-md); background: var(--color-surface-subtle); }
  .journey-facts span { color: var(--color-ink-tertiary); font-size: 0.75rem; }
  @media (max-width: 560px) { .journey-facts { grid-template-columns: 1fr; } }
</style>
