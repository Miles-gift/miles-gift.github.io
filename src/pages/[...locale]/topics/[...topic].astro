---
import DiscoveryPage from "@components/content/DiscoveryPage.astro";
import { entryPath, getArticleEntrySort, getPublicEntries } from "@utils/content-utils";
import { formatFullDate } from "@utils/time";
import { i18n } from "astro:config/client";

export async function getStaticPaths() {
  const [articles, resources, thoughts] = await Promise.all([
    getArticleEntrySort("zh-cn"), getPublicEntries("resources"), getPublicEntries("thoughts"),
  ]);
  const topics = [...new Set([...articles, ...resources, ...thoughts].map((entry) => entry.data.topic))];
  return (i18n?.locales || [i18n?.defaultLocale]).flatMap((locale) => {
    const localeCode = typeof locale === "string" ? locale : locale.path;
    return topics.map((topic) => ({ params: { locale: localeCode === i18n?.defaultLocale ? undefined : localeCode, topic }, props: { topic } }));
  });
}

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const { topic } = Astro.props;
const [articles, resources, thoughts] = await Promise.all([
  getArticleEntrySort(currentLang), getPublicEntries("resources"), getPublicEntries("thoughts"),
]);
const items = [
  ...articles.filter((entry) => entry.data.topic === topic).map((entry) => ({ href: entryPath(entry), eyebrow: "文章", title: entry.data.title, description: entry.data.description, meta: formatFullDate(entry.data.pubDate, currentLang), tags: entry.data.tags })),
  ...resources.filter((entry) => entry.data.topic === topic).map((entry) => ({ href: entryPath(entry), eyebrow: "资料", title: entry.data.title, description: entry.data.description, meta: `学习进度 ${entry.data.progress}%`, tags: entry.data.tags })),
  ...thoughts.filter((entry) => entry.data.topic === topic).map((entry) => ({ href: entryPath(entry), eyebrow: "想法", title: entry.data.title, description: entry.data.description, meta: formatFullDate(entry.data.pubDate, currentLang), tags: entry.data.tags })),
];
---

<DiscoveryPage eyebrow="按主题浏览" title={topic} description={`围绕“${topic}”整理的文章、资料与短想法。`} lang={currentLang} items={items} />
