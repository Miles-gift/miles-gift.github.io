---
import CollectionIndexLayout from "@components/content/CollectionIndexLayout.astro";
import ArticleLibrary from "@components/content/ArticleLibrary.astro";
import Chip from "@components/ui/Chip.astro";
import { siteConfig } from "@/config";
import { getArticleEntrySort } from "@utils/content-utils";
import { i18n } from "astro:config/client";

export function getStaticPaths() {
  return i18n?.locales.map((locale) => ({
    params: { locale: locale === i18n?.defaultLocale ? undefined : String(locale) },
  }));
}

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const articles = await getArticleEntrySort(currentLang);
const topics = [...new Set(articles.map((entry) => entry.data.topic))].sort();
const tags = [...new Set(articles.flatMap((entry) => entry.data.tags))].sort();
---

<CollectionIndexLayout
  title="文章"
  description="教程、复盘与系统思考。记录问题如何发生、尝试如何展开，以及哪些结论值得再次使用。"
  pageTitle={`文章 - ${siteConfig.title}`}
  lang={currentLang}
>
  <nav class="article-discovery" aria-label="文章主题与标签">
    <div><strong>主题</strong>{topics.map((topic) => <Chip href={`/topics/${encodeURIComponent(topic)}/`} tone="accent">{topic}</Chip>)}</div>
    <div><strong>标签</strong>{tags.map((tag) => <Chip href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</Chip>)}</div>
  </nav>
  <ArticleLibrary articles={articles} lang={currentLang} />
</CollectionIndexLayout>

<style>
  .article-discovery { display: grid; gap: var(--space-3); margin-bottom: var(--space-7); padding: var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface-solid); }
  .article-discovery div { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); }
  .article-discovery strong { min-width: 3rem; color: var(--color-ink-secondary); font-size: var(--text-small); }
</style>
