---
import MainPageLayout from "@layouts/MainPageLayout.astro";
import CinematicHero from "@components/ui/CinematicHero.astro";
import FloatingPanel from "@components/ui/FloatingPanel.astro";
import UlboContentRow from "@components/content/UlboContentRow.astro";
import { siteConfig } from "@/config";
import { entryPath, getArticleEntrySort, getPublicEntries } from "@utils/content-utils";
import { formatFullDate } from "@utils/time";
import { i18n } from "astro:config/client";

export function getStaticPaths() { return i18n?.locales.map((locale) => ({ params: { locale: locale === i18n?.defaultLocale ? undefined : String(locale) } })); }
const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const articles = await getArticleEntrySort(currentLang);
const thoughts = (await getPublicEntries("thoughts")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<MainPageLayout title={`文章 - ${siteConfig.title}`} description="长篇札记与灵光便笺。" lang={currentLang}>
  <CinematicHero title="文章与想法" description="把需要展开的问题写清楚，也保存值得继续追问的念头。" />
  <FloatingPanel id="page-content" class="writing-panel">
    <nav class="writing-nav" aria-label="文章分区"><a href="#longform">长篇札记 <span>{articles.length}</span></a><a href="#quick-notes">短想法 <span>{thoughts.length}</span></a><a href="/archives/">时间归档</a></nav>
    <form class="writing-filter" id="writing-filter" role="search"><label for="writing-query">筛选文字</label><input id="writing-query" name="q" type="search" placeholder="搜索标题、主题或标签" /><span id="writing-count" aria-live="polite">{articles.length + thoughts.length} 条记录</span></form>
    <section id="longform" class="writing-section" aria-labelledby="longform-title"><h2 id="longform-title">长篇札记</h2><p>日记、复盘和需要展开说清楚的问题。</p><div class="writing-list">{articles.map((article) => <article data-writing data-search={`${article.data.title} ${article.data.description} ${article.data.topic} ${article.data.tags.join(" ")}`.toLowerCase()}><UlboContentRow href={entryPath(article)} title={article.data.title} description={article.data.description} kind="文章" topic={article.data.topic} date={formatFullDate(article.data.pubDate, currentLang)} tags={article.data.tags} /></article>)}</div></section>
    <section id="quick-notes" class="writing-section" aria-labelledby="quick-title"><h2 id="quick-title">短想法</h2><p>一闪而过，但不想让它们消失的判断和观察。</p><div class="writing-list">{thoughts.map((thought) => <article data-writing data-search={`${thought.data.title} ${thought.data.description} ${thought.data.topic} ${thought.data.tags.join(" ")}`.toLowerCase()}><UlboContentRow href={entryPath(thought)} title={thought.data.title} description={thought.data.description} kind="想法" topic={thought.data.topic} date={formatFullDate(thought.data.pubDate, currentLang)} tags={thought.data.tags} /></article>)}</div></section>
    <p id="writing-empty" class="writing-empty" hidden>没有找到匹配的文字。试试更短的关键词，或清空搜索框。</p>
  </FloatingPanel>
</MainPageLayout>

<style>
  :global(.writing-panel) { padding-bottom: 3rem; }
  .writing-nav { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 2rem; }
  .writing-nav a { padding: .45rem .8rem; border: 1px solid var(--color-border); border-radius: 999px; color: var(--color-ink-secondary); font-size: .86rem; text-decoration: none; }
  .writing-nav a:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .writing-nav span { margin-left: .3rem; color: var(--color-ink-tertiary); }
  .writing-filter { display: flex; align-items: center; gap: 1rem; padding: .7rem 1rem; border: 1px solid var(--color-border); border-radius: 10px; background: var(--color-surface-subtle); }
  .writing-filter label { flex: 0 0 auto; font-weight: 650; }
  .writing-filter input { width: 100%; min-width: 0; border: 0; outline: 0; background: transparent; color: var(--color-ink); }
  .writing-filter span { flex: 0 0 auto; color: var(--color-ink-tertiary); font-size: .78rem; }
  .writing-section { padding-top: 2.5rem; scroll-margin-top: 5rem; }
  .writing-section h2 { margin: 0; font-size: 1.55rem; }
  .writing-section > p { margin: .2rem 0 1.1rem; color: var(--color-ink-secondary); font-size: .9rem; }
  .writing-list { border-top: 1px solid var(--color-border); }
  article[hidden] { display: none; }
  .writing-empty { padding: 2rem; color: var(--color-ink-secondary); text-align: center; }
  @media (max-width: 600px) { .writing-filter { flex-wrap: wrap; }.writing-filter input { flex: 1 1 100%; order: 2; }.writing-filter span { margin-left: auto; } }
</style>

<script>
  function initWritingFilter() {
    const form = document.getElementById("writing-filter");
    const input = document.getElementById("writing-query") as HTMLInputElement | null;
    const count = document.getElementById("writing-count");
    const empty = document.getElementById("writing-empty");
    if (!form || !input || form.dataset.bound === "true") return;
    form.dataset.bound = "true";
    const items = [...document.querySelectorAll<HTMLElement>("[data-writing]")];
    const apply = (updateUrl = true) => {
      const query = input.value.trim().toLowerCase();
      let visible = 0;
      items.forEach((item) => { const show = !query || item.dataset.search?.includes(query); item.hidden = !show; if (show) visible++; });
      if (count) count.textContent = `${visible} 条记录`;
      if (empty) empty.hidden = visible > 0;
      if (updateUrl) { const url = new URL(location.href); query ? url.searchParams.set("q", input.value.trim()) : url.searchParams.delete("q"); history.replaceState({}, "", url); }
    };
    input.value = new URLSearchParams(location.search).get("q") || "";
    apply(false);
    input.addEventListener("input", () => apply());
    window.addEventListener("popstate", () => { if (!form.isConnected) return; input.value = new URLSearchParams(location.search).get("q") || ""; apply(false); });
  }
  document.addEventListener("astro:page-load", initWritingFilter);
</script>
