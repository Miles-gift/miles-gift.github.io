---
import DiscoveryPage from "@components/content/DiscoveryPage.astro";
import { entryPath, getArticleEntrySort, getPublicEntries } from "@utils/content-utils";
import { formatFullDate } from "@utils/time";
import { i18n } from "astro:config/client";

export async function getStaticPaths() {
  const [articles, resources, thoughts, journey] = await Promise.all([
    getArticleEntrySort("zh-cn"), getPublicEntries("resources"), getPublicEntries("thoughts"), getPublicEntries("journey"),
  ]);
  const tags = [...new Set([
    ...articles.flatMap((entry) => entry.data.tags),
    ...resources.flatMap((entry) => entry.data.tags),
    ...thoughts.flatMap((entry) => entry.data.tags),
    ...journey.flatMap((entry) => entry.data.skills),
  ])];
  return (i18n?.locales || [i18n?.defaultLocale]).flatMap((locale) => {
    const localeCode = typeof locale === "string" ? locale : locale.path;
    return tags.map((tag) => ({ params: { locale: localeCode === i18n?.defaultLocale ? undefined : localeCode, tag }, props: { tag } }));
  });
}

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const { tag } = Astro.props;
const [articles, resources, thoughts, journey] = await Promise.all([
  getArticleEntrySort(currentLang), getPublicEntries("resources"), getPublicEntries("thoughts"), getPublicEntries("journey"),
]);
const items = [
  ...articles.filter((entry) => entry.data.tags.includes(tag)).map((entry) => ({ href: entryPath(entry), eyebrow: "Article", title: entry.data.title, description: entry.data.description, meta: formatFullDate(entry.data.pubDate, currentLang), tags: [entry.data.topic, ...entry.data.tags.filter((item) => item !== tag)] })),
  ...resources.filter((entry) => entry.data.tags.includes(tag)).map((entry) => ({ href: entryPath(entry), eyebrow: "Resource", title: entry.data.title, description: entry.data.description, meta: `学习进度 ${entry.data.progress}%`, tags: [entry.data.topic, ...entry.data.tags.filter((item) => item !== tag)] })),
  ...thoughts.filter((entry) => entry.data.tags.includes(tag)).map((entry) => ({ href: entryPath(entry), eyebrow: "Thought", title: entry.data.title, description: entry.data.description, meta: formatFullDate(entry.data.pubDate, currentLang), tags: [entry.data.topic, ...entry.data.tags.filter((item) => item !== tag)] })),
  ...journey.filter((entry) => entry.data.skills.includes(tag)).map((entry) => ({ href: entryPath(entry), eyebrow: "Journey", title: entry.data.title, description: entry.data.summary, meta: entry.data.dateLabel, tags: [entry.data.kind] })),
];
---

<DiscoveryPage eyebrow="按标签浏览" title={`# ${tag}`} description={`使用“${tag}”标记的全部公开内容。`} lang={currentLang} items={items} />
