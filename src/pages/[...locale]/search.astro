---
import { Icon } from "astro-icon/components";
import MainPageLayout from "@layouts/MainPageLayout.astro";
import PageHero from "@components/ui/PageHero.astro";
import { siteConfig } from "@/config";
import { baseUrl } from "@utils/url-utils";
import { i18n } from "astro:config/client";

export function getStaticPaths() {
  return i18n?.locales.map((locale) => ({ params: { locale: locale === i18n?.defaultLocale ? undefined : String(locale) } }));
}

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const scriptUrl = baseUrl("/pagefind/pagefind.js");
---

<MainPageLayout title={`搜索 - ${siteConfig.title}`} description="搜索 yoyo 的长篇札记、灵光便笺、学习原文与旅程坐标。" lang={currentLang} robots="noindex,follow">
  <PageHero title="沿着线索搜索" description="搜索长篇札记、灵光便笺、学习原文与旅程坐标。索引在构建时生成，查询不会发送给远程搜索服务。" align="left" />
  <section class="search-page stage-shell" aria-labelledby="search-page-label" data-pagefind-ignore>
    <h2 id="search-page-label" class="sr-only">全站搜索</h2>
    <form id="site-search-form" role="search">
      <Icon name="fa6-solid:magnifying-glass" class="w-5 h-5" />
      <label class="sr-only" for="site-search-input">搜索关键词</label>
      <input id="site-search-input" type="search" name="q" placeholder="输入关键词，例如 PyTorch、Git、数字花园" autocomplete="off" />
      <button type="submit">搜索</button>
    </form>
    <p id="site-search-status" class="search-page__status" aria-live="polite">输入关键词开始搜索</p>
    <div id="site-search-results" class="search-page__results"></div>
  </section>
</MainPageLayout>

<script is:inline define:vars={{ scriptUrl }}>
  function setupSearchPage() {
    const form = document.getElementById("site-search-form");
    const input = document.getElementById("site-search-input");
    const status = document.getElementById("site-search-status");
    const results = document.getElementById("site-search-results");
    if (!form || !input || !status || !results || form.dataset.bound === "true") return;
    form.dataset.bound = "true";

    const renderResults = (items) => {
      results.replaceChildren();
      items.forEach((item) => {
        const link = document.createElement("a");
        link.href = item.url;
        const meta = document.createElement("small");
        const kind = item.meta?.kind || (item.url.includes("/articles/") ? "文章" : item.url.includes("/resources/") ? "资料" : item.url.includes("/thoughts/") ? "短想法" : item.url.includes("/journey/") ? "旅程" : "页面");
        meta.textContent = [kind, item.meta?.topic, item.meta?.date].filter(Boolean).join("　");
        const label = document.createElement("span");
        label.textContent = item.meta?.title || "未命名页面";
        const excerpt = document.createElement("p");
        const parsed = new DOMParser().parseFromString(item.excerpt || "", "text/html");
        excerpt.textContent = parsed.body.textContent || "";
        link.append(meta, label, excerpt);
        results.append(link);
      });
    };

    const run = async () => {
      const query = input.value.trim();
      const url = new URL(location.href);
      query ? url.searchParams.set("q", query) : url.searchParams.delete("q");
      history.replaceState({}, "", url);
      if (!query) { results.replaceChildren(); status.textContent = "输入关键词开始搜索"; return; }
      status.textContent = "正在搜索…";
      try {
        if (!window.pagefind) {
          const pagefind = await import(scriptUrl);
          await pagefind.options({ excerptLength: 28 });
          window.pagefind = pagefind;
        }
        const response = await window.pagefind.search(query);
        const items = await Promise.all(response.results.map((result) => result.data()));
        renderResults(items);
        status.textContent = items.length ? `找到 ${items.length} 条结果` : "没有找到结果，可以尝试更短的关键词";
      } catch (error) {
        console.error("独立搜索加载失败:", error);
        status.textContent = "搜索索引暂时不可用，请使用生产构建预览后重试";
      }
    };

    form.addEventListener("submit", (event) => { event.preventDefault(); run(); });
    const initial = new URLSearchParams(location.search).get("q");
    if (initial) { input.value = initial; run(); }
  }
  document.addEventListener("astro:page-load", setupSearchPage);
</script>

<style>
  .search-page { padding-bottom: var(--section-space); }
  form { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: var(--space-3); padding: var(--space-3) var(--space-3) var(--space-3) var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius-pill); background: var(--color-surface-solid); box-shadow: var(--shadow-sm); }
  input { min-width: 0; border: 0; outline: 0; background: transparent; color: var(--color-ink); font-size: 1.05rem; }
  button { min-height: 2.75rem; padding-inline: var(--space-5); border: 0; border-radius: var(--radius-pill); background: var(--color-accent); color: #fff; font-weight: 650; cursor: pointer; }
  .search-page__status { margin: var(--space-5) 0; color: var(--color-ink-tertiary); }
  .search-page__results { display: grid; gap: var(--space-3); }
  .search-page__results :global(a) { display: grid; gap: var(--space-2); padding: var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface-solid); color: var(--color-ink); text-decoration: none; }
  .search-page__results :global(a:hover) { border-color: var(--color-border-strong); }
  .search-page__results :global(span) { font-size: 1.12rem; font-weight: 700; }
  .search-page__results :global(small) { color: var(--color-accent); font-size: var(--text-small); font-weight: 650; }
  .search-page__results :global(p) { margin: 0; color: var(--color-ink-secondary); }
  @media (max-width: 520px) { form { grid-template-columns: auto minmax(0, 1fr); border-radius: var(--radius-lg); } button { grid-column: 1 / -1; } }
</style>
