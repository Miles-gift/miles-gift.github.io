---
import { getArticleEntrySort } from "@utils/content-utils";
import { getRelativeLocaleUrl } from "@utils/url-utils";
import { i18n } from "astro:config/client";

export async function getStaticPaths() {
  const paths = [];
  for (const locale of i18n?.locales || [i18n?.defaultLocale]) {
    const localeCode = typeof locale === "string" ? locale : locale.path;
    const entries = await getArticleEntrySort(localeCode);
    for (const entry of entries) {
      paths.push({
        params: { locale: localeCode === i18n?.defaultLocale ? undefined : localeCode, id: entry.id },
        props: { target: getRelativeLocaleUrl(localeCode, `/articles/${entry.id}/`) },
      });
    }
  }
  return paths;
}

const { target } = Astro.props;
const canonical = new URL(target, Astro.site);
---

<!doctype html>
<html lang={Astro.currentLocale || i18n!.defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={canonical} />
    <title>页面已迁移 - Miles</title>
  </head>
  <body>
    <p>页面已迁移到 <a href={target}>{target}</a>。</p>
    <script is:inline define:vars={{ target }}>window.location.replace(target);</script>
  </body>
</html>
