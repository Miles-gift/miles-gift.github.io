---
import MainPageLayout from "@layouts/MainPageLayout.astro";
import CinematicHero from "@components/ui/CinematicHero.astro";
import FloatingPanel from "@components/ui/FloatingPanel.astro";
import Markdown from "@components/misc/Markdown.astro";
import { getSpec } from "@utils/content-utils";
import { siteConfig, profileConfig } from "@/config";
import { render } from "astro:content";
import { i18n } from "astro:config/client";

export async function getStaticPaths() { return i18n?.locales.map((locale) => ({ params: { locale: locale === i18n?.defaultLocale ? undefined : String(locale) } })); }
const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const aboutPost = await getSpec(currentLang, "about");
if (!aboutPost) throw new Error("No about post found");
const { Content } = await render(aboutPost);
---

<MainPageLayout title={`关于 - ${siteConfig.title}`} description="认识 yoyo：研究方向、关注领域、兴趣与公开联系方式。" lang={currentLang}>
  <CinematicHero title="关于 yoyo" description="学习、记录，也继续往前走。" />
  <FloatingPanel id="page-content" class="about-panel">
    <div class="profile-card">
      <div class="profile-card__avatar"><img src="/brand/yoyo-trail.svg" width="180" height="180" alt="yoyo 的轨迹标志" /></div>
      <div class="profile-card__intro"><h2>{profileConfig.name}</h2><p>{profileConfig.description}</p><div><a href="https://github.com/Miles-gift" target="_blank" rel="noopener noreferrer">GitHub</a><a href="/journey/">查看旅程</a></div></div>
    </div>
    <Markdown class="about-content"><Content /></Markdown>
  </FloatingPanel>
</MainPageLayout>

<style>
  .profile-card { display: grid; grid-template-columns: 180px minmax(0, 1fr); align-items: center; gap: clamp(1.5rem, 4vw, 3rem); padding: clamp(1.25rem, 3vw, 2rem); border: 1px solid var(--color-border); border-radius: 14px; background: var(--color-surface-subtle); }
  .profile-card__avatar { display: grid; width: 180px; height: 180px; place-items: center; overflow: hidden; border-radius: 50%; background: var(--color-surface-solid); box-shadow: var(--shadow-sm); }
  .profile-card__avatar img { width: 70%; height: 70%; object-fit: contain; }
  .profile-card__intro h2 { margin: 0; font-size: 2rem; }
  .profile-card__intro p { margin: .5rem 0 1.2rem; color: var(--color-ink-secondary); }
  .profile-card__intro div { display: flex; flex-wrap: wrap; gap: .6rem; }
  .profile-card__intro a { padding: .35rem .75rem; border: 1px solid var(--color-border); border-radius: 999px; color: var(--color-ink); font-size: .85rem; text-decoration: none; }
  .profile-card__intro a:hover { border-color: var(--color-accent); color: var(--color-accent); }
  .about-content { display: block; max-width: 800px; margin: 2rem auto 0; }
  @media (max-width: 620px) { .profile-card { grid-template-columns: 1fr; }.profile-card__avatar { width: 120px; height: 120px; } }
</style>
