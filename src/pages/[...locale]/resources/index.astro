---
import MainPageLayout from "@layouts/MainPageLayout.astro";
import CinematicHero from "@components/ui/CinematicHero.astro";
import FloatingPanel from "@components/ui/FloatingPanel.astro";
import UlboContentRow from "@components/content/UlboContentRow.astro";
import { siteConfig } from "@/config";
import { entryPath, getPublicEntries } from "@utils/content-utils";
import { i18n } from "astro:config/client";

export function getStaticPaths() { return i18n?.locales.map((locale) => ({ params: { locale: locale === i18n?.defaultLocale ? undefined : String(locale) } })); }
const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const resources = (await getPublicEntries("resources")).sort((a, b) => b.data.lastReviewedAt.valueOf() - a.data.lastReviewedAt.valueOf());
const topics = [...new Set(resources.map((item) => item.data.topic))].sort();
---

<MainPageLayout title={`资料库 - ${siteConfig.title}`} description="按主题整理的个人学习资料库，保留原始 Markdown 笔记。" lang={currentLang}>
  <CinematicHero title="资料库" description="课堂笔记、工程工具和语言学习资料，按原始记录持续整理。" />
  <FloatingPanel id="page-content" class="resource-panel">
    <p class="resource-intro">这些资料直接呈现原始 Markdown 笔记。只修正公开展示所需的格式和失效的本地图片路径。</p>
    <div class="resource-tools">
      <nav aria-label="资料分类"><button type="button" data-topic="" class="is-active">全部 <span>{resources.length}</span></button>{topics.map((topic) => <button type="button" data-topic={topic}>{topic} <span>{resources.filter((item) => item.data.topic === topic).length}</span></button>)}</nav>
      <label for="resource-query">筛选资料 <input id="resource-query" type="search" placeholder="标题、主题或标签" /></label>
    </div>
    <div class="resource-groups">{topics.map((topic, index) => <section data-resource-section data-section-topic={topic} aria-labelledby={`resource-topic-${index}`}><header><h2 id={`resource-topic-${index}`}>{topic}</h2><span>{resources.filter((item) => item.data.topic === topic).length} 条资料</span></header><div class="resource-list">{resources.filter((item) => item.data.topic === topic).map((resource) => <article data-resource data-topic={resource.data.topic} data-search={`${resource.data.title} ${resource.data.description} ${resource.data.topic} ${resource.data.tags.join(" ")}`.toLowerCase()}><UlboContentRow href={entryPath(resource)} title={resource.data.title} description={resource.data.description} kind={resource.data.resourceType} topic={resource.data.topic} date={`复核 ${resource.data.lastReviewedAt.toISOString().slice(0, 10)}`} tags={resource.data.tags} /></article>)}</div></section>)}</div>
    <p id="resource-empty" class="resource-empty" hidden>没有匹配的资料。试试更短的关键词，或选择“全部”。</p>
  </FloatingPanel>
</MainPageLayout>

<style>
  .resource-intro { max-width: 48rem; margin: 0 0 1.5rem; color: var(--color-ink-secondary); }
  .resource-tools { display: grid; gap: 1rem; padding: 1rem 0 1.4rem; border-block: 1px solid var(--color-border); }
  .resource-tools nav { display: flex; flex-wrap: wrap; gap: .5rem; }
  .resource-tools button { padding: .42rem .8rem; border: 1px solid var(--color-border); border-radius: 999px; background: transparent; color: var(--color-ink-secondary); font-size: .85rem; cursor: pointer; }
  .resource-tools button:hover, .resource-tools button.is-active { border-color: var(--color-accent); background: var(--color-accent-soft); color: var(--color-accent); }
  .resource-tools button span { margin-left: .25rem; opacity: .75; }
  .resource-tools label { display: flex; align-items: center; gap: 1rem; color: var(--color-ink-secondary); font-size: .85rem; }
  .resource-tools input { width: min(100%, 28rem); min-height: 2.5rem; padding: .4rem .7rem; border: 1px solid var(--color-border); border-radius: 8px; background: var(--color-surface-subtle); color: var(--color-ink); }
  .resource-groups section { padding-top: 2rem; }
  .resource-groups section[hidden], article[hidden] { display: none; }
  .resource-groups header { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: .8rem; }
  .resource-groups h2 { margin: 0; font-size: 1.5rem; }
  .resource-groups header span { color: var(--color-ink-tertiary); font-size: .8rem; }
  .resource-list { border-top: 1px solid var(--color-border); }
  .resource-empty { padding: 2rem 0; color: var(--color-ink-secondary); text-align: center; }
  @media (max-width: 600px) { .resource-tools label { align-items: stretch; flex-direction: column; gap: .3rem; }.resource-tools input { width: 100%; } }
</style>

<script>
  function initResourceFilter() {
    const input = document.getElementById("resource-query") as HTMLInputElement | null;
    const buttons = [...document.querySelectorAll<HTMLButtonElement>(".resource-tools [data-topic]")];
    const groups = [...document.querySelectorAll<HTMLElement>("[data-resource-section]")];
    const empty = document.getElementById("resource-empty");
    if (!input || input.dataset.bound === "true") return;
    input.dataset.bound = "true";
    let topic = new URLSearchParams(location.search).get("topic") || "";
    input.value = new URLSearchParams(location.search).get("q") || "";
    const apply = (updateUrl = true) => {
      const query = input.value.trim().toLowerCase();
      let total = 0;
      groups.forEach((group) => { let visible = 0; group.querySelectorAll<HTMLElement>("[data-resource]").forEach((item) => { const show = (!topic || item.dataset.topic === topic) && (!query || item.dataset.search?.includes(query)); item.hidden = !show; if (show) visible++; }); group.hidden = visible === 0; total += visible; });
      buttons.forEach((button) => { const active = button.dataset.topic === topic; button.classList.toggle("is-active", active); button.setAttribute("aria-pressed", String(active)); });
      if (empty) empty.hidden = total > 0;
      if (updateUrl) { const url = new URL(location.href); topic ? url.searchParams.set("topic", topic) : url.searchParams.delete("topic"); query ? url.searchParams.set("q", input.value.trim()) : url.searchParams.delete("q"); history.replaceState({}, "", url); }
    };
    buttons.forEach((button) => button.addEventListener("click", () => { topic = button.dataset.topic || ""; apply(); }));
    input.addEventListener("input", () => apply());
    window.addEventListener("popstate", () => { if (!input.isConnected) return; const params = new URLSearchParams(location.search); topic = params.get("topic") || ""; input.value = params.get("q") || ""; apply(false); });
    apply(false);
  }
  document.addEventListener("astro:page-load", initResourceFilter);
</script>
