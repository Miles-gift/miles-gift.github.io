---
import CollectionIndexLayout from "@components/content/CollectionIndexLayout.astro";
import ResourceLibrary from "@components/content/ResourceLibrary.astro";
import { siteConfig } from "@/config";
import { getPublicEntries } from "@utils/content-utils";
import { i18n } from "astro:config/client";

export function getStaticPaths() {
  return i18n?.locales.map((locale) => ({ params: { locale: locale === i18n?.defaultLocale ? undefined : String(locale) } }));
}

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const resources = (await getPublicEntries("resources")).sort((a, b) => b.data.lastReviewedAt.valueOf() - a.data.lastReviewedAt.valueOf());
---

<CollectionIndexLayout
  title="资料库"
  description="经过来源核验的课程、书籍、文档与工具索引；每条都附保存原因、学习状态和自己的使用方式。"
  pageTitle={`资料库 - ${siteConfig.title}`}
  lang={currentLang}
>
  <ResourceLibrary resources={resources} />
</CollectionIndexLayout>
