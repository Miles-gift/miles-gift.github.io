---
import ContentEntryLayout from "@components/content/ContentEntryLayout.astro";
import Button from "@components/ui/Button.astro";
import { siteConfig } from "@/config";
import { getPublicEntries } from "@utils/content-utils";
import { render } from "astro:content";
import { i18n } from "astro:config/client";

export async function getStaticPaths() {
  const entries = await getPublicEntries("resources");
  return (i18n?.locales || [i18n?.defaultLocale]).flatMap((locale) => {
    const localeCode = typeof locale === "string" ? locale : locale.path;
    return entries.map((entry) => ({ params: { locale: localeCode === i18n?.defaultLocale ? undefined : localeCode, slug: entry.data.slug }, props: { entry } }));
  });
}

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ContentEntryLayout pageTitle={`${entry.data.title} - ${siteConfig.title}`} title={entry.data.title} description={entry.data.description} eyebrow="资料库 · 原始笔记" lang={currentLang} pubDate={entry.data.pubDate} topic={entry.data.topic} tags={entry.data.tags} backHref="/resources/" backLabel="资料库">
  <Fragment slot="aside">
    <div class="resource-facts">
      <div><span>格式</span><strong>Markdown 原文</strong></div>
      <div><span>来源</span><strong>{entry.data.sourceKind === "personal-note" ? "本人原始笔记" : "外部资料"}</strong></div>
      <div><span>分类</span><strong>{entry.data.topic}</strong></div>
      <div><span>公开复核</span><strong>{entry.data.lastReviewedAt.toISOString().slice(0, 10)}</strong></div>
    </div>
    {entry.data.sourceKind === "external" && entry.data.sourceUrl && <Button href={entry.data.sourceUrl} target="_blank" variant="secondary" size="small">访问外部来源</Button>}
  </Fragment>
  <p class="original-note">以下为本人原始笔记。除公开展示所需的格式修正外，不作总结或概括。</p>
  {entry.data.takeaways.length > 0 && <section class="takeaways" aria-labelledby="takeaways-title"><h2 id="takeaways-title">原笔记索引</h2><ul>{entry.data.takeaways.map((item) => <li>{item}</li>)}</ul></section>}
  <Content />
</ContentEntryLayout>

<style>
  .resource-facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-3); margin-bottom: var(--space-4); }
  .resource-facts div { display: grid; gap: var(--space-1); padding: var(--space-3); border-radius: var(--radius-sm); background: var(--color-surface-subtle); }
  .resource-facts span { color: var(--color-ink-tertiary); font-size: 0.75rem; }
  .resource-facts strong { font-size: var(--text-small); }
  .takeaways { margin-bottom: var(--space-7); padding: var(--space-5); border: 1px solid color-mix(in srgb, var(--color-accent) 22%, var(--color-border)); border-radius: var(--radius-md); background: var(--color-accent-soft); }
  .takeaways h2 { margin-top: 0; }
  .takeaways ul { margin-bottom: 0; }
  .original-note { margin: 0 0 var(--space-7); padding: var(--space-4) 0; border-block: 1px dashed var(--color-annotation); color: var(--color-annotation); font-family: var(--font-display); font-size: 1.05rem; }
  @media (max-width: 640px) { .resource-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
