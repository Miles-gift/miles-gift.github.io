---
import ContentEntryLayout from "@components/content/ContentEntryLayout.astro";
import Button from "@components/ui/Button.astro";
import { siteConfig } from "@/config";
import { getPublicEntries } from "@utils/content-utils";
import { render } from "astro:content";
import { i18n } from "astro:config/client";

export async function getStaticPaths() {
  const entries = await getPublicEntries("resources");
  return (i18n?.locales || [i18n?.defaultLocale]).flatMap((locale) => {
    const localeCode = typeof locale === "string" ? locale : locale.path;
    return entries.map((entry) => ({ params: { locale: localeCode === i18n?.defaultLocale ? undefined : localeCode, slug: entry.data.slug }, props: { entry } }));
  });
}

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ContentEntryLayout variant="resource" pageTitle={`${entry.data.title} - ${siteConfig.title}`} title={entry.data.title} description={entry.data.description} eyebrow="资料库 · 原始笔记" lang={currentLang} pubDate={entry.data.pubDate} topic={entry.data.topic} tags={entry.data.tags} backHref="/resources/" backLabel="资料库">
  <Fragment slot="aside">
    <div class="resource-facts">
      <div><span>格式</span><strong>Markdown 原文</strong></div>
      <div><span>来源</span><strong>{entry.data.sourceKind === "personal-note" ? "本人原始笔记" : "外部资料"}</strong></div>
      <div><span>分类</span><strong>{entry.data.topic}</strong></div>
      <div><span>公开复核</span><strong>{entry.data.lastReviewedAt.toISOString().slice(0, 10)}</strong></div>
    </div>
    {entry.data.sourceKind === "external" && entry.data.sourceUrl && <Button href={entry.data.sourceUrl} target="_blank" variant="secondary" size="small">访问外部来源</Button>}
  </Fragment>
  <p class="original-note">以下为本人原始笔记。除公开展示所需的格式修正外，不作总结或概括。</p>
  {entry.data.takeaways.length > 0 && <section class="takeaways" aria-labelledby="takeaways-title"><h2 id="takeaways-title">原笔记索引</h2><ul>{entry.data.takeaways.map((item) => <li>{item}</li>)}</ul></section>}
  <Content />
</ContentEntryLayout>

<style>
  .resource-facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .65rem; margin-bottom: var(--space-5); }
  .resource-facts div { display: grid; min-height: 4.25rem; gap: .35rem; padding: .75rem .85rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface-solid); }
  .resource-facts span { color: var(--color-ink-tertiary); font-size: .72rem; letter-spacing: .04em; }
  .resource-facts strong { align-self: end; font-size: var(--text-small); font-weight: 600; }
  .takeaways { position: relative; margin-bottom: var(--space-7); padding: 1.2rem 1.35rem 1.25rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface); }
  .takeaways::before { display: none; }
  .takeaways h2 { margin: 0 0 .7rem; color: var(--color-ink); font-size: 1.25rem; }
  .takeaways ul { margin: 0; }
  .original-note { display: flex; align-items: baseline; gap: .6rem; margin: 0 0 var(--space-6); padding: .8rem 0; border-block: 1px solid var(--color-border); color: var(--color-ink-secondary); font-size: var(--text-small); }
  .original-note::before { content: "NOTE"; flex: 0 0 auto; color: var(--color-accent); font-size: .72rem; font-weight: 650; letter-spacing: .08em; }
  @media (max-width: 640px) { .resource-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); } .original-note { display: block; } .original-note::before { display: block; margin-bottom: .25rem; } }
</style>
