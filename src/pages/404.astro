---
import MainPageLayout from "@layouts/MainPageLayout.astro";
import Button from "@components/ui/Button.astro";
import { siteConfig } from "@/config";
---

<MainPageLayout title={`页面没有找到 - ${siteConfig.title}`} description="请求的页面不存在，可能已经迁移或地址输入有误。" lang="zh-cn">
  <section class="not-found stage-shell" aria-labelledby="not-found-title">
    <p class="not-found__code">404</p>
    <h1 id="not-found-title">这里暂时没有内容。</h1>
    <p>页面可能已经迁移、尚未公开，或地址输入有误。可以回到首页、搜索站内内容，或按新的文章路径继续浏览。</p>
    <div>
      <Button href="/" size="large">返回首页</Button>
      <Button href="/search/" variant="secondary" size="large">全站搜索</Button>
      <Button href="/articles/" variant="quiet" size="large">浏览文章</Button>
    </div>
  </section>
</MainPageLayout>

<style>
  .not-found { display: grid; min-height: calc(100svh - var(--header-height)); place-content: center; padding-block: var(--space-9); text-align: center; }
  .not-found__code { margin: 0; color: transparent; background: linear-gradient(110deg, var(--color-accent), #8b5cf6); background-clip: text; -webkit-background-clip: text; font-size: clamp(6rem, 20vw, 14rem); font-weight: 780; letter-spacing: -0.08em; line-height: 0.8; }
  h1 { margin: var(--space-7) 0 0; font-size: var(--text-display-md); letter-spacing: var(--tracking-tight); }
  section > p:not(.not-found__code) { max-width: 39rem; margin: var(--space-5) auto 0; color: var(--color-ink-secondary); font-size: 1.08rem; }
  section > div { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3); margin-top: var(--space-7); }
</style>
