---
import MainPageLayout from "@layouts/MainPageLayout.astro";
import Button from "@components/ui/Button.astro";
import CinematicHero from "@components/ui/CinematicHero.astro";
import FloatingPanel from "@components/ui/FloatingPanel.astro";
import { siteConfig } from "@/config";
---

<MainPageLayout title={`页面没有找到 - ${siteConfig.title}`} description="请求的页面不存在，可能已经迁移或地址输入有误。" lang="zh-cn" robots="noindex,follow">
  <CinematicHero title="还没走到这里" description="这个地址没有找到对应的页面。" />
  <FloatingPanel id="page-content">
  <section class="not-found" aria-labelledby="not-found-title">
    <p class="not-found__code">404</p>
    <h2 id="not-found-title">这里暂时没有内容。</h2>
    <p>页面可能已经迁移、尚未公开，或地址输入有误。可以回到首页、搜索站内内容，或按新的文章路径继续浏览。</p>
    <div>
      <Button href="/" size="large">返回首页</Button>
      <Button href="/search/" variant="secondary" size="large">全站搜索</Button>
      <Button href="/articles/" variant="quiet" size="large">浏览文章</Button>
    </div>
  </section>
  </FloatingPanel>
</MainPageLayout>

<style>
  .not-found { display: grid; place-content: center; padding-block: var(--space-7); text-align: center; }
  .not-found__code { margin: 0; color: var(--color-accent); font-family: var(--font-display); font-size: clamp(4rem, 13vw, 7rem); font-weight: 700; line-height: 1; }
  h2 { margin: var(--space-5) 0 0; font-family: var(--font-display); font-size: var(--text-title); font-weight: 600; }
  section > p:not(.not-found__code) { max-width: 39rem; margin: var(--space-5) auto 0; color: var(--color-ink-secondary); font-size: 1.08rem; }
  section > div { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3); margin-top: var(--space-7); }
</style>
