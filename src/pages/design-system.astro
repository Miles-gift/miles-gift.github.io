---
import MainPageLayout from "@layouts/MainPageLayout.astro";
import Button from "@components/ui/Button.astro";
import Chip from "@components/ui/Chip.astro";
import IconButton from "@components/ui/IconButton.astro";
import PageHero from "@components/ui/PageHero.astro";
import Section from "@components/ui/Section.astro";
import { Icon } from "astro-icon/components";
---

<MainPageLayout title="设计系统 - Miles" lang="zh-cn" description="Miles 个人站设计系统验证页">
  <div data-pagefind-ignore="all">
    <PageHero
      eyebrow="Miles Design System"
      title="清晰，是最安静的力量。"
      description="这张内部验证页集中检查颜色、字体、间距、控件、表面与深浅主题。它服务于一致性，不进入主导航。"
    >
      <Fragment slot="actions">
        <Button href="#components" size="large">查看组件</Button>
        <Button href="#type" variant="secondary" size="large">排版样张</Button>
      </Fragment>
    </PageHero>

    <Section id="foundations" eyebrow="01 / Foundations" title="从少量决定开始" description="黑、白、低饱和灰构成舞台，单一蓝色只负责动作与重点。">
      <div class="swatch-grid">
        <article class="swatch swatch--canvas"><span>Canvas</span><code>--color-canvas</code></article>
        <article class="swatch swatch--raised"><span>Raised</span><code>--color-canvas-raised</code></article>
        <article class="swatch swatch--ink"><span>Ink</span><code>--color-ink</code></article>
        <article class="swatch swatch--accent"><span>Accent</span><code>--color-accent</code></article>
      </div>
      <div class="token-row" aria-label="间距刻度">
        {[1, 2, 3, 4, 5, 6, 7].map((step) => <span style={`--token-step: var(--space-${step})`} title={`space-${step}`}></span>)}
      </div>
    </Section>

    <Section id="type" tone="raised" eyebrow="02 / Typography" title="先读懂，再感受" description="标题使用系统无衬线字体建立舞台感；长文使用中文衬线字体，保持稳定的阅读节奏。">
      <div class="type-sample">
        <p class="display">持续学习，也持续留下些什么。</p>
        <p class="title">工程、学习与成长</p>
        <p class="body">把复杂的问题拆开，把每次试验和修正留下。好的排版不抢走内容的注意力，它只是让层级自然出现。</p>
        <p class="meta">2026 · HUST · LEARNING IN PUBLIC</p>
      </div>
    </Section>

    <Section id="components" eyebrow="03 / Components" title="状态完整，使用简单" description="基础组件覆盖默认、悬停、聚焦、按下和禁用状态，并保持至少 44px 的主要触控目标。">
      <div class="component-stack">
        <div class="component-row">
          <Button>主要操作</Button>
          <Button variant="secondary">次要操作</Button>
          <Button variant="quiet">安静操作</Button>
          <Button disabled>不可用</Button>
        </div>
        <div class="component-row">
          <Chip>工程工具</Chip>
          <Chip tone="accent">AI 与机器学习</Chip>
          <Chip tone="success">已完成</Chip>
          <Chip href="#foundations">可点击标签</Chip>
        </div>
        <div class="component-row">
          <IconButton label="示例搜索按钮"><Icon name="fa6-solid:magnifying-glass" class="w-4 h-4" /></IconButton>
          <IconButton label="示例添加按钮"><Icon name="fa6-solid:plus" class="w-4 h-4" /></IconButton>
        </div>
      </div>
    </Section>

    <Section tone="raised" eyebrow="04 / Surfaces" title="层级来自光与距离" description="边框只做分隔，阴影只说明抬升；圆角在卡片与控件之间保持一致。">
      <div class="surface-grid">
        <article class="surface-card">
          <Chip tone="accent">Featured</Chip>
          <h3>一块内容，一个重点</h3>
          <p>卡片不堆叠无关信息，让标题、摘要和动作形成清晰顺序。</p>
          <Button variant="quiet" href="/about/">查看关于</Button>
        </article>
        <article class="surface-card surface-card--dark">
          <Chip>Dark stage</Chip>
          <h3>深色不是简单反转</h3>
          <p>重新设置表面、文字、边框和强调色，保持层级与对比。</p>
        </article>
      </div>
    </Section>
  </div>
</MainPageLayout>

<style>
  .swatch-grid,
  .surface-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .swatch {
    display: flex;
    min-height: 10rem;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  .swatch span { font-weight: 700; }
  .swatch code { margin-top: var(--space-1); font-family: var(--font-mono); font-size: 0.75rem; opacity: 0.72; }
  .swatch--canvas { background: var(--color-canvas); }
  .swatch--raised { background: var(--color-canvas-raised); }
  .swatch--ink { background: var(--color-ink); color: var(--color-canvas); }
  .swatch--accent { background: var(--color-accent); color: #fff; }

  .token-row {
    display: flex;
    min-height: 5rem;
    align-items: flex-end;
    gap: var(--space-4);
    margin-top: var(--space-7);
  }

  .token-row span {
    display: block;
    width: var(--token-step);
    height: var(--token-step);
    min-width: 0.25rem;
    min-height: 0.25rem;
    border-radius: 0.2rem;
    background: var(--color-accent);
  }

  .type-sample { max-width: 54rem; }
  .type-sample p { margin: 0; }
  .display { font: 700 var(--text-display-md) / var(--leading-heading) var(--font-display); letter-spacing: var(--tracking-tight); }
  .title { margin-top: var(--space-7) !important; font: 700 var(--text-title) / var(--leading-heading) var(--font-display); }
  .body { max-width: 42rem; margin-top: var(--space-5) !important; font-family: var(--font-reading); font-size: 1.08rem; line-height: 1.9; }
  .meta { margin-top: var(--space-6) !important; color: var(--color-ink-tertiary); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; }

  .component-stack {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface-solid);
    box-shadow: var(--shadow-sm);
  }

  .component-row { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); }

  .surface-card {
    min-height: 22rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface-solid);
    box-shadow: var(--shadow-md);
  }

  .surface-card--dark { background: #000; color: #f5f5f7; }
  .surface-card h3 { max-width: 12ch; margin: var(--space-8) 0 0; font: 700 var(--text-title) / var(--leading-heading) var(--font-display); letter-spacing: -0.025em; }
  .surface-card p { max-width: 32rem; color: var(--color-ink-secondary); }
  .surface-card--dark p { color: #a1a1a6; }

  @media (max-width: 700px) {
    .swatch-grid,
    .surface-grid { grid-template-columns: 1fr; }
    .swatch { min-height: 8rem; }
    .surface-card { min-height: 18rem; }
  }
</style>
